FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /repo
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* .npmrc ./
COPY app/package.json ./app/package.json
# api/package.json is copied so the workspace matches the lockfile for a frozen
# install, but we only install the web app's own dependency tree — the API's
# heavy deps (AWS SDK, Prisma, etc.) aren't needed to build the Next.js app and
# bloated the image enough to hit ENOSPC on smaller disks.
COPY api/package.json ./api/package.json
RUN pnpm install --frozen-lockfile --filter caseiq-web...

FROM base AS builder
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/app/node_modules ./app/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* turbo.json* ./
COPY app ./app
# app/src/lib/api.ts imports from the repo-root shared/ workspace (../../../shared/*),
# so it must be present in the build image or the Next.js type-check fails.
COPY shared ./shared
WORKDIR /repo/app
# Deliberately no NEXT_PUBLIC_API_URL or NEXT_PUBLIC_SITE_URL.
#
# Next inlines NEXT_PUBLIC_* into the bundle during `pnpm build`, so accepting
# those two here compiled one environment's hostnames into the image and made it
# unpromotable — QA and production could not run the same artifact, which is
# most of the reason to have a QA tier. They are now resolved per request:
# the API origin by getApiOrigin() falling back to same-origin /v1 (proxied by
# nginx), and the site origin by SITE_URL via src/lib/siteConfig.ts.
#
# The ones below are genuinely build-time and genuinely production-only, so they
# stay. Setting them on the running container does nothing, and does it
# silently: analytics and the verification tags simply never render. All three
# are optional and the build succeeds without them.
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=${NEXT_PUBLIC_GA_MEASUREMENT_ID}
ARG NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
ENV NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=${NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION}
ARG NEXT_PUBLIC_BING_SITE_VERIFICATION
ENV NEXT_PUBLIC_BING_SITE_VERIFICATION=${NEXT_PUBLIC_BING_SITE_VERIFICATION}
RUN pnpm build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Stamps the running image, as the API image already does. A web image older than
# the API is invisible from the outside and produces symptoms that look nothing
# like a stale build: a consent checkbox the API had begun requiring was simply
# not rendered, so every case submitted was held back at the routing gate with no
# error anywhere. Read with `docker inspect` or `exec web env`.
ARG GIT_COMMIT=""
ARG BUILD_TIME=""
ENV GIT_COMMIT=$GIT_COMMIT
ENV BUILD_TIME=$BUILD_TIME

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Next.js standalone output. With outputFileTracingRoot at the repo root, the
# standalone bundle mirrors the workspace layout: it contains a top-level
# node_modules/ and the app under ./app, so server.js lives at ./app/server.js.
COPY --from=builder /repo/app/.next/standalone ./
COPY --from=builder /repo/app/.next/static ./app/.next/static
COPY --from=builder /repo/app/public ./app/public

USER nextjs
EXPOSE 3000

# server.js is generated by Next's standalone output and needs no pnpm/corepack.
CMD ["node", "app/server.js"]
