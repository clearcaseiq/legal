# Copy to .env.qa on the QA host and fill real values. Never commit .env.qa.
#
#   docker compose -f docker-compose.deploy.yml --env-file .env.qa up -d
#
# Do NOT produce this file by copying .env.prod. Two of its values are actively
# dangerous when carried over: DATABASE_URL (the API runs `prisma db push` on
# every boot, so QA holding production's URL pushes schema changes into
# production) and EMAIL_PROVIDER (see "Outbound is off" below).

# Selects deploy/nginx/qa.conf and namespaces the container names.
DEPLOY_ENV=qa

# ---- Published images ----
# The same two artifacts production runs, identified by the full commit SHA the
# workflow tagged. Promoting QA to production is then a retag of something that
# has already been tested here, rather than a rebuild from a git ref on a
# different machine.
#
# Leave them unset only for a local `docker compose build`: compose then falls
# back to clearcaseiq-api:local, which on a host that has never built is an
# image that does not exist.
API_IMAGE=302524629649.dkr.ecr.us-east-1.amazonaws.com/clearcaseiq-api:REPLACE_WITH_COMMIT_SHA
WEB_IMAGE=302524629649.dkr.ecr.us-east-1.amazonaws.com/clearcaseiq-web:REPLACE_WITH_COMMIT_SHA

# ---- Database ----
# QA's own RDS instance. Must not be the production one, and must not be a
# second database on the production instance unless you have accepted that they
# share a failure domain.
DATABASE_URL=postgresql://clearcaseiq:REPLACE@clearcaseiq-qa.REPLACE.us-east-1.rds.amazonaws.com:5432/clearcaseiq?sslmode=require

# ---- Public URLs ----
# No defaults exist for these in docker-compose.deploy.yml; the stack refuses to
# start without them rather than falling back to production.
API_URL=https://api-qa.clearcaseiq.com
WEB_URL=https://qa.clearcaseiq.com
SITE_URL=https://qa.clearcaseiq.com
# The browser reaches the API same-origin through nginx, so this only covers
# non-browser and cross-origin clients.
CORS_ORIGINS=https://qa.clearcaseiq.com
TRUST_PROXY=1

# ---- Keep QA out of the search index ----
# QA serves the same 176 indexable pages as production. Without this it competes
# with the live site for its own queries. Turns robots.txt into a blanket
# disallow and marks every page noindex.
SEARCH_ENGINE_INDEXING=disabled

# ---- Secrets ----
# Generate fresh. Reusing production's JWT_SECRET would make tokens minted in QA
# valid in production.
JWT_SECRET=generate-a-new-one-do-not-copy-from-prod
SESSION_SECRET=generate-a-new-one-do-not-copy-from-prod

# ---- Storage / OCR ----
AWS_REGION=us-east-1
FILE_BUCKET=s3
# A separate bucket. The QA instance role should not be able to read or write
# the production one at all.
S3_BUCKET=clearcaseiq-qa-uploads
OCR_PROVIDER=aws_textract
ENABLE_OCR=true
PDF_TEXTRACT_FALLBACK=true

# ---- Outbound is off, and stays off by omission ----
# resolveEmailProvider() returns 'none' when EMAIL_PROVIDER is empty and neither
# SES_FROM_EMAIL nor RESEND_API_KEY is set, so nothing is sent. Note that
# EMAIL_PROVIDER=ses *forces* SES even with no from-address configured — which
# is why copying this value from .env.prod is the specific mistake to avoid.
EMAIL_PROVIDER=
SES_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Same shape for SMS: unset means isSmsConfigured() is false and nothing sends.
# QA data is synthetic, but synthetic records still carry phone-shaped strings,
# and the reminder jobs do not know the difference.
SMS_PROVIDER=
SNS_ORIGINATION_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Payments ----
# Test-mode keys only (sk_test_…, pk_test_…). The webhook must be a separate
# endpoint registered against api-qa.clearcaseiq.com with its own signing
# secret; a production webhook secret will fail signature verification here,
# which looks like a broken integration rather than a config error.
#
# Nothing fails the deploy when these are blank — the stack comes up healthy and
# simply cannot take money. After filling them in, confirm with:
#   docker compose -f docker-compose.deploy.yml exec api \
#     npx tsx scripts/verify-stripe.ts
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_SUBSCRIPTION_PRICE_ID=
STRIPE_LEAD_CREDIT_PRICE_ID=

# ---- AI / ML ----
# Its own key so QA usage is separable on the bill and can be capped.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
ML_PREDICTION_MODE=fallback
ML_SERVICE_URL=
ML_RETRIEVAL_ENABLED=false

# ---- OAuth ----
# Each redirect URI below must also be registered in that provider's console
# against the QA hostname. They are additions to the existing app registration,
# not replacements — do not edit the production URIs. Missing registrations are
# the usual cause of "QA login is broken".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-qa.clearcaseiq.com/v1/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://api-qa.clearcaseiq.com/v1/auth/apple/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://api-qa.clearcaseiq.com/v1/auth/microsoft/callback

# ---- Attorney calendar sync ----
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api-qa.clearcaseiq.com/v1/attorney-calendar/callback/google
GOOGLE_CALENDAR_WEBHOOK_URI=https://api-qa.clearcaseiq.com/v1/attorney-calendar/webhooks/google
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=https://api-qa.clearcaseiq.com/v1/attorney-calendar/callback/microsoft
MICROSOFT_CALENDAR_WEBHOOK_URI=https://api-qa.clearcaseiq.com/v1/attorney-calendar/webhooks/microsoft
# Off in QA: the renewal job calls out to Google and Microsoft on a timer, which
# is noise against test subscriptions that nothing is watching.
CALENDAR_WEBHOOK_RENEWAL_ENABLED=false

# ---- Zoom ----
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://api-qa.clearcaseiq.com/v1/attorney-zoom/callback

# ---- Behavior ----
REQUIRE_EMAIL_VERIFICATION=false
ADMIN_EMAILS=admin@clearcaseiq.com
