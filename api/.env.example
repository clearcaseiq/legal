# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/injury_intelligence?schema=public"
# Optional explicit local database URL for data comparison/refresh scripts.
# If omitted, DATABASE_URL is used as the local database.
LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/injury_intelligence?schema=public"
# Supabase direct Postgres connection string used only by comparison/refresh scripts.
# Do not commit real credentials.
SUPABASE_DATABASE_URL=

# Auth
JWT_SECRET="your-super-secret-jwt-key-here"

# OpenAI — the only provider for text completions and image generation.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Allows incident narratives and medical detail into LLM prompts. Requires a
# HIPAA BAA with OpenAI. Left false, the intake narrative is never sent and
# incident extraction returns null without calling the model — the feature is
# off rather than degraded, which is easy to mistake for a broken endpoint.
# Contact PII is redacted either way.
LLM_ALLOW_PHI=false

# Anthropic Claude (optional — incident extraction + planning bake-off)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_PLANNING_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Workflow AI adapt (gpt-4o planning). Richer patches + gap-change re-adapt.
WORKFLOW_AI_ADAPT=true
WORKFLOW_AI_ADAPT_MAX_OPS=18
WORKFLOW_AI_ADAPT_MAX_ADDS=8
WORKFLOW_AI_ADAPT_ON_GAP_CHANGE=true
# 15 minutes between automatic gap-change adapts
WORKFLOW_AI_ADAPT_GAP_COOLDOWN_MS=900000

# SerpAPI (optional, for Google search-backed law firm discovery)
SERPAPI_API_KEY=

# Google Places API (New) — law firm discovery.
# Billed per request: Text Search Enterprise is $35/1,000 with 1,000 free per month.
# Restrict the key to the Places API and to this server's IP. Never expose it to a browser.
# Enable "Places API (New)" in the Cloud console; the legacy "Places API" is a different product.
GOOGLE_PLACES_API_KEY=

# OCR / text extraction for medical_records & bills evidence
# Raster (PDF/image): skipped only when ENABLE_OCR=false (default is on — medical extraction needs this).
# - OCR_PROVIDER=tesseract → install Tesseract and ensure it is on PATH.
# - OCR_PROVIDER=aws_textract → AWS credentials + Textract access (same region as AWS_REGION).
# DOCX uploads always use built-in text extraction (no OCR). Legacy .doc is not parsed.
ENABLE_OCR=true
OCR_PROVIDER=tesseract
# After aws login: scanned PDFs use Textract when embedded text is empty/thin (default on).
PDF_TEXTRACT_FALLBACK=true
AWS_REGION=us-east-1
# Textract synchronous DetectDocumentText: PDF-as-bytes often returns UnsupportedDocumentException for
# multi-page PDFs; the API then falls back to rendering page 1 as PNG and OCRing that image. Multi-page
# scans may need async StartDocumentTextDetection if you must OCR every page.
# Configure AWS credentials through `aws configure`, AWS_PROFILE, or your runtime environment.

# ---- Recorded plaintiff calls (Amazon Connect + Contact Lens + Transcribe) ----
# Master switch (default on). Set to false to hide the recorded-call UI/API.
CALLS_ENABLED=true
# Region of the Connect instance + its recordings bucket + Transcribe jobs.
# Often differs from AWS_REGION (Textract/SES). Defaults to AWS_REGION when unset.
# CONNECT_REGION=us-west-2
# Amazon Connect instance id (UUID) that places the outbound calls.
# CONNECT_INSTANCE_ID=
# Contact flow that bridges plaintiff -> attorney, plays the recording
# disclosure, and enables recording + Contact Lens (id from the Connect console).
# CONNECT_CONTACT_FLOW_ID=
# Claimed Connect phone number used as the caller id (E.164), e.g. +18885551234.
# CONNECT_SOURCE_PHONE_NUMBER=
# Optional outbound queue id.
# CONNECT_QUEUE_ID=
# S3 bucket where Connect writes recordings + Contact Lens analysis. Subscribe
# this bucket's S3 events (and/or Connect contact events) via SNS (HTTPS) to
# https://your-api.com/v1/calls/connect/events
# CONNECT_RECORDINGS_BUCKET=
# Fallback transcription language for Amazon Transcribe when Contact Lens is off.
CALL_TRANSCRIBE_LANGUAGE=en-US

# ---- Compliance feature gates (SB 37 / B&P Code) ----
# Attorney-to-medical-provider referrals: the lien-filtered provider directory,
# provider referral records, and letters of protection. Off by default. B&P
# § 6155(f)(2)-(3) makes shared operations with an entity that refers to health
# care providers cause for denial or revocation of referral-service
# certification, and speaks to operations rather than only to payment. Do not
# enable until it is settled whether ClearCaseIQ pursues certification. Existing
# referrals and treatment records stay readable while this is off.
PROVIDER_REFERRALS_ENABLED=false
# Re-engagement outreach to people who abandoned an intake. Off by default: the
# shipped copy predicted a settlement on an unevaluated case and named no
# attorney. Do not enable until the copy carries § 6157.2 disclosures.
INTAKE_ABANDONMENT_OUTREACH_ENABLED=false

# ML service integration
ML_SERVICE_URL=http://localhost:8000
# fallback = heuristics only, shadow = heuristics plus ML comparison, primary = ML-first with heuristic fallback
ML_PREDICTION_MODE=shadow
ML_LABELING_MODEL=gpt-4o-mini
ML_REQUEST_TIMEOUT_MS=5000
ML_RETRIEVAL_ENABLED=true
ML_RETRIEVAL_TOP_K=4
ML_PROMPT_VERSION=legal-grounded-v1

# Rose intake engine LLM model (defaults to the provider's chat model if unset).
ROSE_LLM_MODEL=
ROSE_LLM_TIMEOUT_MS=1800

# Twilio SMS (optional, for case routing Accept/Decline via text)
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend Email (optional, for real outbound email delivery)
# Get credentials at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Dropbox Sign (retainers / HIPAA authorizations). The requester name and
# mailbox are what claimants see in "X has requested a signature".
# DROPBOX_SIGN_API_KEY=
# DROPBOX_SIGN_REQUESTER_NAME=ClearCaseIQ
# DROPBOX_SIGN_REQUESTER_EMAIL=noreply@clearcaseiq.com
# Add noreply@clearcaseiq.com as a team member in Dropbox Sign or the send
# retries with the name only (Gmail still appears next to it).

# URLs
API_URL=http://localhost:4000
# Public base URL of the web app, and the root of every link emailed to a user
# (password resets, booking pages, document upload requests). REQUIRED in
# production: the API refuses to start without it rather than send links to
# localhost. APP_URL and FRONTEND_URL are accepted as legacy aliases, but set
# only one of the three.
WEB_URL=http://localhost:3100

# Stripe payments (optional until configured)
STRIPE_SECRET_KEY=
# Publishable key (pk_...) — served to the web app via GET /v1/payments/config
# to power in-app card entry (Stripe Payment Element).
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_SUBSCRIPTION_PRICE_ID=
STRIPE_LEAD_CREDIT_PRICE_ID=

# LegalMatch production import
# Set NODE_ENV=production and LEGALMATCH_ALLOW_PRODUCTION_IMPORT=true to enable.
LEGALMATCH_ALLOW_PRODUCTION_IMPORT=false
LEGALMATCH_DRY_RUN=false
LEGALMATCH_MAX_PROFILES=100
LEGALMATCH_FETCH_DELAY_MS=1500
LEGALMATCH_FETCH_MODE=auto
# Browser mode requires Playwright Chromium to be installed.
LEGALMATCH_BROWSER_HEADLESS=true
# Discovery mode: auto, sitemap, search, browser-search, or browser-index.
LEGALMATCH_DISCOVERY_MODE=auto
# Optional: skip already imported LegalMatch source URLs so repeated runs can advance to new profiles.
LEGALMATCH_SKIP_IMPORTED=false
# Optional: skip the first N discovered URLs before importing the next batch.
LEGALMATCH_DISCOVERY_OFFSET=0
# Optional: for browser-search discovery, paginate up to this many results pages per query.
LEGALMATCH_SEARCH_PAGES_PER_QUERY=3
# Optional: for browser-index discovery, paginate this many attorney index pages.
LEGALMATCH_INDEX_PAGES=4
# Optional: comma-separated list of public attorney profile URLs to import directly.
LEGALMATCH_PROFILE_URLS=
# Optional: newline or comma-separated search queries for indexed-profile fallback discovery.
LEGALMATCH_SEARCH_QUERIES=
# Optional: override sitemap discovery entrypoint.
LEGALMATCH_SITEMAP_URL=https://www.legalmatch.com/sitemap.xml.gz

# Microsoft Outlook calendar sync (attorney OAuth via Microsoft Graph).
# Create an app at https://portal.azure.com → App registrations → New registration:
#   - Supported accounts: personal Microsoft + work/school (or "common")
#   - Redirect URI (Web): http://localhost:4000/v1/attorney-calendar/callback/microsoft
# API permissions (delegated): openid, email, profile, offline_access, User.Read,
#   Calendars.Read, Calendars.ReadWrite — then grant admin consent if required.
# Certificates & secrets → New client secret. Restart API after setting these.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Optional. Defaults to ${API_URL}/v1/attorney-calendar/callback/microsoft
# MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:4000/v1/attorney-calendar/callback/microsoft
# Optional. Needs a public HTTPS API URL for Graph change notifications.
# MICROSOFT_CALENDAR_WEBHOOK_URI=

# Zoom (per-attorney OAuth). Leave blank to run without Zoom: consults can still
# be booked as video, the UI just asks the attorney to paste a Meet/Teams link.
# Create a User-managed OAuth app at https://marketplace.zoom.us/develop/create
# with scopes user:read and meeting:write, and point its redirect URL at
# ZOOM_REDIRECT_URI. Restart the API after setting these.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional. Defaults to ${API_URL}/v1/attorney-zoom/callback when unset.
# ZOOM_REDIRECT_URI=http://localhost:4000/v1/attorney-zoom/callback

# HTTP server bind (default 0.0.0.0 = all interfaces, so phones on LAN can connect using your PC IP)
# HOST=0.0.0.0
