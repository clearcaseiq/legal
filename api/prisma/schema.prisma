// A general firm calendar event (MyCase-style "Add event"): may be linked to a
// case or standalone, can repeat, carries reminder offsets, and invites both
// firm staff and client contacts. Owner is the creating attorney. IDs for
// attorney/assessment/lawFirm are stored without FK relations to keep the
// change surface small; they are resolved manually in the route.
model CalendarEvent {
  id           String @id @default(cuid())
  attorneyId   String // owning/creating attorney
  lawFirmId    String?
  assessmentId String? // optional case link (null => not linked to a case)
  createdById  String? // User id of the creator

  title       String
  description String? @db.Text
  location    String?

  startAt DateTime
  endAt   DateTime
  allDay  Boolean  @default(false)

  // Recurrence: repeatFreq in (daily, weekly, monthly); null => single event.
  repeatFreq  String?
  repeatUntil DateTime?

  // JSON reminders. Legacy: number[] of minutes-before. New: array of
  // { offsetMinutes, recipient: attorneys|contacts|all, channel: email|popup }.
  reminders String?

  // Private events are visible only to the creator and invited attendees.
  isPrivate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees CalendarEventAttendee[]

  @@index([attorneyId, startAt])
  @@index([assessmentId])
  @@index([lawFirmId])
  @@map("calendar_events")
}

model CalendarEventAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  kind         String // 'staff' | 'client'
  firmMemberId String? // when kind = staff
  userId       String? // client/staff user id when known
  email        String?
  name         String?

  attend Boolean @default(false) // "Attend" flag
  share  Boolean @default(true) // "Share" flag (staff visibility)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([userId])
  @@map("calendar_event_attendees")
}

// A bookable "event type" for the attorney's public scheduling page (Calendly's
// core concept), e.g. "15-min intro call" or "30-min case consultation".
model AttorneyEventType {
  id                  String   @id @default(cuid())
  attorneyId          String
  attorney            Attorney @relation(fields: [attorneyId], references: [id], onDelete: Cascade)

  name                String
  slug                String
  description         String?  @db.Text
  durationMinutes     Int      @default(30)
  locationType        String   @default("video") // video, phone, in_person
  location            String? // address / dial-in note for in_person / phone
  color               String? // hex accent for the public page
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  minNoticeMinutes    Int      @default(120) // earliest a slot can be booked from "now"
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attorneyId, slug])
  @@index([attorneyId])
  @@map("attorney_event_types")
}

// RETIRED. Firm-level ("team") booking links were removed from the product:
// the Firm Workspace tab, the public /book/team page and every route that read
// these tables are gone. The models stay because the deploy entrypoint runs
// `prisma db push` without --accept-data-loss and treats failure as fatal, so
// dropping a table that still holds rows would stop the API from booting.
// To finish decommissioning, confirm both tables are empty in every
// environment, drop them explicitly, and only then delete these models.
//
// They described a link that distributed bookings across a pool of attorneys
// (round-robin or first-available), with slots drawn from the union of members'
// availability and the attorney resolved at booking time. Attorney *personal*
// booking links are a separate mechanism and are still live: see
// Attorney.bookingSlug and AttorneyEventType.
model FirmBookingLink {
  id                  String  @id @default(cuid())
  lawFirmId           String
  lawFirm             LawFirm @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  slug                String
  name                String
  description         String? @db.Text
  durationMinutes     Int     @default(30)
  locationType        String  @default("video") // video, phone, in_person
  location            String?
  bufferBeforeMinutes Int     @default(0)
  bufferAfterMinutes  Int     @default(0)
  minNoticeMinutes    Int     @default(120)
  assignmentStrategy  String  @default("round_robin") // round_robin, first_available
  lastAssignedAttorneyId String? // round-robin cursor
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members FirmBookingLinkMember[]

  @@unique([lawFirmId, slug])
  @@index([lawFirmId])
  @@map("firm_booking_links")
}

// RETIRED alongside FirmBookingLink; see the note above that model.
model FirmBookingLinkMember {
  id         String          @id @default(cuid())
  linkId     String
  link       FirmBookingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  attorneyId String
  attorney   Attorney        @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  sortOrder  Int             @default(0)

  @@unique([linkId, attorneyId])
  @@index([attorneyId])
  @@map("firm_booking_link_members")
}

// Firm-level reusable document templates (retainer, HIPAA, intake package,
// etc.). Each template can carry an editable text/markdown body AND/OR an
// uploaded source file (PDF/DOCX). PDF-backed templates can be sent for
// signature against a specific case via the e-signature service.
model FirmTemplate {
  id          String  @id @default(cuid())
  lawFirmId   String
  lawFirm     LawFirm @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  name        String
  // Category bucket for grouping in the UI, e.g. onboarding, medical,
  // insurance, disclosure, closing, other.
  category    String  @default("other")
  description String? @db.Text

  // Editable text/markdown body with optional merge tokens like {{client_name}}.
  body        String? @db.Text

  // Optional uploaded source document.
  fileName    String?
  filePath    String?
  fileMime    String?
  fileSize    Int?

  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lawFirmId])
  @@map("firm_templates")
}

// A customizable case-lifecycle workflow (pipeline of stages, each with a
// checklist of steps). Firms can keep several (e.g. one per practice area) and
// mark one as the default. This pass defines/customizes templates only; applying
// a workflow to an individual case + progress tracking comes later.
model FirmWorkflow {
  id           String  @id @default(cuid())
  lawFirmId    String
  lawFirm      LawFirm @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  name         String
  description  String? @db.Text
  practiceArea String?

  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  phases       FirmWorkflowPhase[]
  stages       FirmWorkflowStage[]

  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lawFirmId])
  @@map("firm_workflows")
}

// A high-level phase of a program's case pipeline (e.g. Intake, Medical,
// Settlement, Litigation, Closing). Groups one or more stages. `key` is a
// stable slug used for pipeline rendering/matching.
model FirmWorkflowPhase {
  id          String       @id @default(cuid())
  workflowId  String
  workflow    FirmWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name        String
  key         String?
  description String?      @db.Text
  sortOrder   Int          @default(0)

  stages      FirmWorkflowStage[]

  @@index([workflowId])
  @@map("firm_workflow_phases")
}

model FirmWorkflowStage {
  id          String       @id @default(cuid())
  workflowId  String
  workflow    FirmWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Optional parent phase (null for legacy/flat workflows).
  phaseId     String?
  phase       FirmWorkflowPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  name        String
  description String?      @db.Text
  sortOrder   Int          @default(0)

  steps       FirmWorkflowStep[]

  @@index([workflowId])
  @@index([phaseId])
  @@map("firm_workflow_stages")
}

model FirmWorkflowStep {
  id            String            @id @default(cuid())
  stageId       String
  stage         FirmWorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  title         String
  description   String?           @db.Text
  // Step type: task | milestone | checkpoint | deadline | document | ai_milestone.
  stepType      String            @default("task")
  // For ai_milestone steps: a signal key that derives read-only completion.
  aiSignal      String?
  // Suggested role responsible, e.g. attorney, paralegal, case_manager, intake_specialist.
  assigneeRole  String?
  // Optional default assignee (FirmMember.id) auto-applied to new cases.
  assigneeFirmMemberId String?
  // Due offset in days relative to when the stage starts (null = no target).
  dueOffsetDays Int?
  required      Boolean           @default(false)
  // Optional link to a firm template/document used at this step.
  templateId    String?

  // Optional apply-time condition: only snapshot this step onto a case when the
  // resolved case field matches. op in (eq, neq, in, notin).
  conditionField String?
  conditionOp    String?
  conditionValue String?

  sortOrder     Int               @default(0)

  @@index([stageId])
  @@map("firm_workflow_steps")
}

// A firm workflow applied to a specific case. This is a point-in-time snapshot
// of the firm's workflow (stage/step structure is copied into CaseWorkflowItem
// rows) so later edits to the firm template don't disrupt in-flight matters.
model CaseWorkflow {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  lawFirmId    String?

  // Source firm workflow (may be null if that template is later deleted).
  sourceWorkflowId String?
  name             String
  description      String? @db.Text

  // Basis for computing step due dates (appliedAt + step.dueOffsetDays).
  startDate    DateTime @default(now())
  status       String   @default("active") // active, archived

  appliedById  String?
  appliedAt    DateTime @default(now())

  // Set when GPT planning adapted this case's snapshot (apply-time or manual).
  aiAdaptedAt      DateTime?
  aiAdaptRationale String?   @db.Text
  aiAdaptRunId     String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items CaseWorkflowItem[]

  @@index([lawFirmId])
  @@map("case_workflows")
}

model CaseWorkflowItem {
  id             String       @id @default(cuid())
  caseWorkflowId String
  caseWorkflow   CaseWorkflow @relation(fields: [caseWorkflowId], references: [id], onDelete: Cascade)

  // Phase + stage info is denormalized so a case workflow is a single flat
  // checklist regrouped into a phase -> stage pipeline on the client.
  phaseName  String?
  phaseOrder Int?
  stageName  String
  stageOrder Int    @default(0)

  title         String
  description   String? @db.Text
  stepType      String  @default("task")
  aiSignal      String?
  assigneeRole  String?
  // Specific person responsible for this step on this case (FirmMember.id).
  assignedFirmMemberId String?
  dueOffsetDays Int?
  dueDate       DateTime?
  required      Boolean @default(false)
  templateId    String?

  status        String    @default("pending") // pending, done, skipped
  completedAt   DateTime?
  completedById String?

  // Ad-hoc task added on the case itself (not part of the firm template snapshot).
  custom    Boolean  @default(false)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseWorkflowId])
  @@index([assignedFirmMemberId, status])
  @@map("case_workflow_items")
}

// Firm billing rates for time tracking. A rate is either a role default
// (role set) or a per-person override (firmMemberId set). Per-person overrides
// win over role defaults when resolving the rate for a time entry.
model BillingRate {
  id        String  @id @default(cuid())
  lawFirmId String
  lawFirm   LawFirm @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  role         String? // set for a role-default rate (attorney, paralegal, ...)
  firmMemberId String? // set for a per-person override

  hourlyRate Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lawFirmId, role])
  @@unique([lawFirmId, firmMemberId])
  @@index([lawFirmId])
  @@map("billing_rates")
}

// A logged unit of team time. Case-scoped when assessmentId is set. Even on a
// contingency practice this feeds profitability, fee petitions, and lien/fee
// disputes; the resolved rate is snapshotted so later rate changes don't
// rewrite history.
model TimeEntry {
  id        String  @id @default(cuid())
  lawFirmId String
  lawFirm   LawFirm @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Optional link to a specific case task this time was logged against.
  caseTaskId String?

  // The person who performed the work (kept as ids to avoid heavy back-relations).
  userId       String?
  firmMemberId String?
  attorneyId   String?
  role         String? // snapshot of the worker's role at entry time

  workDate     DateTime
  minutes      Int
  activityType String  @default("general") // intake, drafting, comms, court, research, travel, admin, general
  description  String? @db.Text
  billable     Boolean @default(true)

  hourlyRate Float? // snapshot rate applied
  amount     Float? // minutes/60 * hourlyRate (when billable + rate known)

  status       String    @default("submitted") // draft, submitted, approved, rejected, invoiced
  approvedById String?
  approvedAt   DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lawFirmId, status])
  @@index([assessmentId])
  @@index([caseTaskId])
  @@index([userId])
  @@map("time_entries")
}

model ChatRoom {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attorneyId   String
  attorney     Attorney    @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  status        String    @default("ACTIVE") // 'ACTIVE', 'CLOSED', 'ARCHIVED'
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages Message[]

  @@unique([userId, attorneyId])
  @@map("chat_rooms")
}

model Message {
  id         String   @id @default(cuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId   String // User ID or Attorney ID
  senderType String // 'user' or 'attorney'

  content     String
  messageType String  @default("text") // 'text', 'image', 'file', 'system'
  metadata    String? // JSON for additional data

  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("messages")
}

// ---- Recorded plaintiff <-> attorney calls (Amazon Connect + Contact Lens) ----
// A Call is a single recorded phone conversation placed through Amazon Connect.
// We store loose scalar references (userId/attorneyId/assessmentId/chatRoomId)
// instead of hard relations so the feature stays self-contained and calls can
// survive if the linked record is later archived. Recording + transcript arrive
// asynchronously via the Connect/S3 webhook and are attached once ready.
model Call {
  id String @id @default(cuid())

  // Who is on the call. userId = plaintiff (nullable for guest leads).
  userId       String?
  attorneyId   String?
  assessmentId String?
  chatRoomId   String?

  // Who pressed "call" and the numbers actually dialed (E.164). Stored for the
  // audit trail; masked in API responses.
  initiatedBy      String? // 'plaintiff' | 'attorney' | 'staff'
  initiatedByUserId String?
  plaintiffPhone   String?
  attorneyPhone    String?

  // Amazon Connect linkage.
  provider        String  @default("amazon_connect")
  connectContactId String? @unique // ContactId returned by StartOutboundVoiceContact
  connectInstanceId String?

  // Lifecycle: queued -> ringing -> in_progress -> completed | failed | no_answer | canceled
  status       String    @default("queued")
  direction    String    @default("outbound")
  failureReason String?
  startedAt    DateTime?
  answeredAt   DateTime?
  endedAt      DateTime?
  durationSec  Int?

  // Two-party recording consent captured before the call is placed. The Connect
  // contact flow also plays a spoken disclosure to both parties at connect time.
  recordingConsent      Boolean   @default(false)
  recordingConsentAt    DateTime?
  recordingConsentBy    String? // user/attorney id who acknowledged
  recordingConsentNote  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recording  CallRecording?
  transcript CallTranscript?

  @@index([userId])
  @@index([attorneyId])
  @@index([assessmentId])
  @@index([chatRoomId])
  @@index([status])
  @@map("calls")
}

model CallRecording {
  id     String @id @default(cuid())
  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  // Where Amazon Connect wrote the recording (S3). We keep bucket/key so we can
  // generate short-lived signed URLs on demand rather than storing public links.
  s3Bucket   String?
  s3Key      String?
  mediaType  String  @default("audio/wav")
  durationSec Int?
  sizeBytes  Int?

  status    String   @default("pending") // pending | available | failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("call_recordings")
}

model CallTranscript {
  id     String @id @default(cuid())
  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  // 'contact_lens' when Amazon Connect Contact Lens produced it, or 'transcribe'
  // when we ran Amazon Transcribe on the recording ourselves.
  source   String @default("contact_lens")
  language String @default("en-US")

  status    String  @default("pending") // pending | processing | ready | failed
  fullText  String? @db.Text
  segments  String? @db.Text // JSON: [{ speaker, startMs, endMs, text }]

  // LLM-derived extraction (summary + action items + sentiment) built from the
  // transcript. Kept separate from raw text so re-summarization is cheap.
  summary      String? @db.Text
  actionItems  String? @db.Text // JSON string[]
  keyFacts     String? @db.Text // JSON string[]
  sentiment    String? // positive | neutral | negative
  processedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("call_transcripts")
}

model ChatBotSession {
  id        String  @id @default(cuid())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String  @unique

  context         String // JSON context for the conversation
  lastInteraction DateTime @default(now())
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("chatbot_sessions")
}

// Attorney Dashboard & Lead Management Models

model AttorneyDashboard {
  id         String   @id @default(cuid())
  attorneyId String   @unique
  attorney   Attorney @relation(fields: [attorneyId], references: [id], onDelete: Cascade)

  // Lead Quality Settings
  leadFilters         String? // JSON filters for case type, location, damages, etc.
  exclusivitySettings String? // JSON settings for exclusive/first-look options

  // Performance Tracking
  totalLeadsReceived Int   @default(0)
  totalLeadsAccepted Int   @default(0)
  totalFeesCollected Float @default(0)
  totalPlatformSpend Float @default(0)

  // Pricing Preferences
  pricingModel    String  @default("per_lead") // 'per_lead', 'per_consult', 'per_retainer'
  volumeDiscounts String? // JSON volume discount settings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attorney_dashboard")
}

model CaseIntakeRequest {
  id           String      @id @default(cuid())
  attorneyId   String
  attorney     Attorney    @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  leadId       String?
  kind         String
  source       String?
  payload      String?
  status       String      @default("queued")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("case_intake_requests")
}

model AttorneyIntakeConfig {
  id         String   @id @default(cuid())
  attorneyId String   @unique
  attorney   Attorney @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  config     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("attorney_intake_configs")
}

model LeadSubmission {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Lead Quality Metrics
  viabilityScore Float @default(0)
  liabilityScore Float @default(0)
  causationScore Float @default(0)
  damagesScore   Float @default(0)

  // Evidence Checklist
  evidenceChecklist String? @db.Text // JSON checklist of uploaded/missing documents

  // Exclusivity & Source
  isExclusive   Boolean @default(false)
  sourceType    String // 'organic_search', 'paid_ad', 'referral', 'direct'
  sourceDetails String? // JSON additional source info

  // Lead Hotness
  submittedAt   DateTime  @default(now())
  lastContactAt DateTime?
  hotnessLevel  String    @default("warm") // 'hot', 'warm', 'cold'

  // Attorney Assignment
  assignedAttorneyId String?
  assignedAttorney   Attorney? @relation(fields: [assignedAttorneyId], references: [id], onDelete: SetNull)
  assignmentType     String    @default("shared") // 'exclusive', 'first_look', 'shared'

  // Conversion Tracking
  status      String    @default("submitted") // 'submitted', 'contacted', 'consulted', 'retained', 'rejected'
  convertedAt DateTime?

  // Routing Lifecycle (Step 17)
  lifecycleState String  @default("routing_active") // assessment_completed, routing_active, attorney_review, attorney_matched, consultation_scheduled, engaged, closed
  routingLocked  Boolean @default(false) // true when attorney accepts - stops further routing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactAttempts     LeadContact[]
  caseContacts        CaseContact[]
  conflictChecks      ConflictCheck[]
  qualityReports      QualityReport[]
  providerReferrals   ProviderReferral[]
  lettersOfProtection LetterOfProtection[]
  decisionMemory      DecisionMemory?
  documentRequests    DocumentRequest[]
  documentEnvelopes   DocumentEnvelope[]

  // Attorney and firm dashboards read their own pipeline by status.
  @@index([assignedAttorneyId, status])
  @@index([lifecycleState])
  @@map("lead_submissions")
}

// Partial intake lead captured before the assessment is submitted.
// Lets the team recover abandoned intakes that shared an email or phone.
model IntakeLead {
  id           String  @id @default(cuid())
  email        String?
  phone        String?
  injuryType   String?
  venueState   String?
  venueCounty  String?
  currentStep  String?
  // Ordered JSON array of { step, at }, appended each time the claimant reaches a
  // new step. `currentStep` alone says where someone stopped but not how long
  // each step took or which branch they went down, which is the difference
  // between knowing the funnel leaks and knowing where.
  stepHistory  String? @db.Text
  formSnapshot String? @db.Text // JSON of in-progress answers
  status       String  @default("in_progress") // 'in_progress', 'completed'
  assessmentId String? @unique // linked once the assessment is created

  // Provisional (passwordless) account auto-created from the captured email.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Set once the "you left the platform" re-engagement email/SMS has been sent,
  // so the abandonment sweep only contacts each lead a single time.
  abandonmentEmailedAt DateTime?

  /// When the "your case report is ready" email becomes sendable.
  ///
  /// Finishing the assessment and sending the case to attorneys are separate
  /// steps, and each sent its own email — the report one on the first, the
  /// receipt on the second. Someone who did both in a single sitting got two
  /// messages a minute apart, the earlier of which invited them back to
  /// something they had just finished.
  ///
  /// Holding the report email briefly lets a submission supersede it, with the
  /// receipt carrying the report link instead. It cannot be decided at
  /// completion time because that is when the report email fires and the
  /// submission has not happened yet. Cleared once handled, either way.
  reportReadyDueAt DateTime?

  /// Set when the report email actually went out, so it is never sent twice.
  reportReadySentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status, updatedAt])
  @@index([userId])
  /// Supports the sweep that drains due report-ready emails.
  @@index([reportReadyDueAt])
  @@map("intake_leads")
}

model DecisionMemory {
  id                    String         @id @default(cuid())
  leadId                String         @unique
  lead                  LeadSubmission @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assessmentId          String
  assessment            Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attorneyId            String
  attorney              Attorney       @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  lawFirmId             String?
  lawFirm               LawFirm?       @relation(fields: [lawFirmId], references: [id], onDelete: SetNull)
  recommendedDecision   String
  recommendedConfidence Float
  recommendedRationale  String?
  recommendedData       String?
  attorneyDecision      String?
  attorneyRationale     String?
  override              Boolean        @default(false)
  decisionAt            DateTime?
  outcomeStatus         String?
  outcomeNotes          String?
  outcomeAt             DateTime?

  // Case resolution + satisfaction tracking (attorney- and plaintiff-reported).
  retained                   Boolean?  // whether the attorney was retained on this case
  settlementAmount           Float? // gross resolution amount (settlement or verdict)
  wentToTrial                Boolean?  // true when the case was resolved at trial (verdict)
  attorneySatisfaction       Int? // attorney-reported satisfaction, 1-5
  attorneySatisfactionNotes  String?   @db.Text
  plaintiffSatisfaction      Int? // plaintiff-reported satisfaction, 1-5
  plaintiffSatisfactionNotes String?   @db.Text
  plaintiffSatisfactionAt    DateTime?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([lawFirmId])
  @@index([attorneyId])
  @@index([assessmentId])
  @@map("decision_memories")
}

model LeadContact {
  id         String         @id @default(cuid())
  leadId     String
  lead       LeadSubmission @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attorneyId String
  attorney   Attorney       @relation(fields: [attorneyId], references: [id], onDelete: Cascade)

  contactType   String // 'call', 'sms', 'email', 'chat', 'consult'
  contactMethod String? // phone number, email, chat room ID
  status        String  @default("pending") // 'pending', 'sent', 'delivered', 'opened', 'responded'

  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_contacts")
}

model CaseContact {
  id         String         @id @default(cuid())
  leadId     String
  lead       LeadSubmission @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attorneyId String
  attorney   Attorney       @relation(fields: [attorneyId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  email       String?
  phone       String?
  companyName String?
  companyUrl  String?
  title       String? // e.g. "Plaintiff", "Adjuster", "Opposing Counsel"
  contactType String? // 'client', 'opposing_counsel', 'adjuster', 'witness', 'medical_provider', 'expert', 'other'
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([attorneyId])
  @@map("case_contacts")
}

model DocumentRequest {
  id         String         @id @default(cuid())
  leadId     String
  lead       LeadSubmission @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attorneyId String
  attorney   Attorney       @relation(fields: [attorneyId], references: [id], onDelete: Cascade)

  requestedDocs String  @db.Text // JSON array: police_report, medical_records, injury_photos, wage_loss, insurance, other
  customMessage String?
  secureToken   String  @unique // UUID for secure upload link
  uploadLink    String // Full URL for the recipient (plaintiff portal or external portal)
  status        String  @default("pending") // pending, partial, completed

  // Who the request is addressed to. Default flow is the claimant ('plaintiff').
  // 'opposing_party' is a defendant / opposing counsel / insurer with no platform account,
  // served through a tokenized external upload portal.
  targetType     String  @default("plaintiff") // 'plaintiff' | 'opposing_party'
  recipientName  String? // name of the opposing party / insurer / counsel
  recipientEmail String? // external recipient email (no platform account)
  recipientRole  String? // 'defendant' | 'opposing_counsel' | 'insurer'
  caseContactId  String? // optional link to a CaseContact representing the recipient
  origin         String  @default("attorney") // 'attorney' | 'plaintiff_suggested'

  // Links a provider-directed medical-records request to the signed HIPAA
  // authorization (DocumentEnvelope) that legally permits the disclosure. The
  // custodian portal exposes this authorization; the request is gated on it
  // being signed before it can be served.
  documentEnvelopeId String?
  documentEnvelope   DocumentEnvelope? @relation(fields: [documentEnvelopeId], references: [id], onDelete: SetNull)

  attorneyViewedAt DateTime?
  lastNudgeAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalUploads ExternalDocumentUpload[]

  @@index([leadId])
  @@index([secureToken])
  @@map("document_requests")
}

// Files produced by an external recipient (defendant / opposing counsel / insurer)
// in response to an opposing-party DocumentRequest. These are NOT owned by a
// plaintiff User the way EvidenceFile is, so fulfillment is tracked separately.
model ExternalDocumentUpload {
  id                String          @id @default(cuid())
  documentRequestId String
  documentRequest   DocumentRequest @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)

  docType        String? // which requested doc this fulfills
  originalName   String
  storedName     String
  filePath       String
  mimeType       String?
  sizeBytes      Int?
  uploadedByName String?
  note           String?

  createdAt DateTime @default(now())

  @@index([documentRequestId])
  @@map("external_document_uploads")
}

// Tracks an e-signature envelope for a signable case document (retainer
// agreement, HIPAA authorization, fee agreement). Provider-agnostic: the same
// record works whether the envelope is created via Dropbox Sign, a self-hosted
// Documenso instance, or an in-house signer. `status` is the source of truth
// for the "Documents & E-sign" surface, so the app no longer has to infer
// "retained" from lifecycle state — a signed retainer sets it explicitly.
model DocumentEnvelope {
  id         String         @id @default(cuid())
  leadId     String
  lead       LeadSubmission @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attorneyId String
  attorney   Attorney       @relation(fields: [attorneyId], references: [id], onDelete: Cascade)

  // What is being signed and by whom (the client, usually).
  documentType String // 'retainer' | 'hipaa_authorization' | 'fee_agreement' | 'other'
  title        String
  signerName   String
  signerEmail  String

  // Provider-agnostic signing state — the value the UI reads.
  status String @default("draft") // draft, sent, viewed, signed, declined, voided, expired

  // Provider linkage (null until the envelope is created remotely).
  provider           String  @default("dropbox_sign") // 'dropbox_sign' | 'documenso' | 'internal'
  externalEnvelopeId String? // provider's envelope / signature-request id
  signingUrl         String? // embedded or hosted signing URL for the signer
  auditTrailUrl      String? // provider certificate of completion / audit trail
  signedFilePath     String? // stored fully-executed PDF once completed

  // Lifecycle timestamps, set as provider webhooks arrive.
  sentAt     DateTime?
  viewedAt   DateTime?
  signedAt   DateTime?
  declinedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentRequests DocumentRequest[]

  @@index([leadId])
  @@index([attorneyId])
  @@index([status])
  @@index([provider, externalEnvelopeId])
  @@map("document_envelopes")
}

// A plaintiff-initiated suggestion that documents should be requested from the
// defendant/opposing party. The plaintiff cannot serve discovery directly; their
// attorney reviews the suggestion and converts it into a real DocumentRequest.
model OpposingDocRequestSuggestion {
  id                String  @id @default(cuid())
  assessmentId      String
  leadId            String?
  suggestedByUserId String?

  requestedDocs     String  @db.Text // JSON array of requested doc types
  recipientName     String?
  recipientRole     String? // 'defendant' | 'opposing_counsel' | 'insurer'
  note              String? @db.Text
  status            String  @default("pending") // 'pending' | 'sent' | 'dismissed'
  documentRequestId String? // set once an attorney converts it into a real request

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([leadId])
  @@map("opposing_doc_request_suggestions")
}

model AttorneyProfile {
  id         String   @id @default(cuid())
  attorneyId String   @unique
  attorney   Attorney @relation("AttorneyProfile", fields: [attorneyId], references: [id], onDelete: Cascade)

  // Profile Details
  bio         String?
  photoUrl    String?
  specialties String? // JSON array of specialties
  languages   String? // JSON array of languages
  // Fluency per language, as a JSON object keyed by the language name:
  // {"Spanish":"professional"}. Deliberately kept separate from `languages`
  // rather than folded into it, because routing matches on the plain name and
  // reshaping that array would mean touching the matching engine. A language
  // with no entry here simply displays without a fluency badge.
  languageProficiency String?

  // Success Stats
  yearsExperience   Int   @default(0)
  // Years specifically on personal injury work, which is the number that
  // matters for matching and is usually lower than time at the bar.
  yearsPiExperience Int   @default(0)
  totalCases        Int   @default(0)
  totalSettlements  Float @default(0)
  averageSettlement Float @default(0)
  successRate       Float @default(0)

  // Superseded by the AttorneyCaseResult table, which case results moved to so
  // that a review queue can select pending rows without parsing every
  // attorney's blob. Left in place, and backfilled from rather than dropped,
  // because `prisma db push` runs on boot and would abort on a populated column.
  verifiedVerdicts String? @db.Text // retired: JSON array of case outcomes

  // Featured Placement
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?
  boostLevel    Int       @default(0) // 0-5 boost level

  // Reviews & Ratings
  totalReviews  Int   @default(0)
  averageRating Float @default(0)

  // ===== FIRM INFORMATION =====
  firmName      String? // Firm name
  firmWebsite   String? // Firm website URL
  firmLocations String? // JSON array of locations {address, city, state, zip, phone}

  // ===== JURISDICTIONS =====
  jurisdictions      String? // JSON array of {state, counties: [], cities: []} - counties/cities covered
  secondaryCaseTypes String? // JSON array of secondary case types

  // ===== CASE PREFERENCES =====
  minInjurySeverity        Int? // Minimum injury severity level (0-4) they accept
  excludedCaseTypes        String? // JSON array of case types to exclude
  minDamagesRange          Float? // Minimum damages range they accept
  maxDamagesRange          Float? // Maximum damages range they accept (null = no max)
  insuranceRequired        Boolean? // Require insurance on cases
  mustHaveMedicalTreatment Boolean? // Require medical treatment
  requirePoliceReport      Boolean? // Require police report
  requireMedicalRecords    Boolean? // Require medical records

  // ===== CAPACITY SIGNALS =====
  maxCasesPerWeek  Int? // Maximum new cases per week
  maxCasesPerMonth Int? // Maximum new cases per month
  intakeHours      String? // JSON array of {dayOfWeek, startTime, endTime} or "24/7"

  // ===== BUYING PREFERENCES =====
  pricingModel     String? // 'fixed_price', 'auction', 'both'
  paymentModel     String? // 'subscription', 'pay_per_case', 'both'
  subscriptionTier String? // 'basic', 'premium', 'enterprise' (if subscription)

  // ===== SUBSCRIPTION & ACCOUNT TRACKING =====
  subscriptionActive          Boolean   @default(false) // Whether subscription is currently active
  subscriptionRemainingCases  Int? // Remaining cases in current subscription period
  accountBalance              Float     @default(0) // Account balance for pay-per-case
  tier1Enabled                Boolean   @default(false) // Enable Tier 1 routing
  tier2Enabled                Boolean   @default(false) // Enable Tier 2 routing
  stripeCustomerId            String?   @unique
  stripeSubscriptionId        String?   @unique
  stripeSubscriptionStatus    String?
  stripeSubscriptionPriceId   String?
  stripeCurrentPeriodEnd      DateTime?
  stripeConnectAccountId      String?   @unique
  stripeConnectChargesEnabled Boolean   @default(false)
  stripeConnectPayoutsEnabled Boolean   @default(false)

  // ===== ROUTING METRICS (calculated/aggregated) =====
  historicalAcceptanceRate  Float? // Historical acceptance rate (0-1)
  responseSpeedScore        Float? // Response speed score (0-1)
  recentConversionScore     Float? // Recent conversion score (0-1)
  recentTier1ConversionRate Float? // Tier 1 specific conversion rate (0-1)
  recentTier2ConversionRate Float? // Tier 2 specific conversion rate (0-1)
  accountBalanceWeight      Float? // Account balance weight for ranking (0-1)

  // ===== ATTORNEY LICENSE =====
  licenseNumber             String? // State bar license number
  licenseState              String? // State where licensed (2-letter code)
  licenseFileUrl            String? // URL/path to uploaded license file
  licenseFileName           String? // Original filename of license document
  licenseVerified           Boolean   @default(false) // Whether license has been verified
  licenseVerifiedAt         DateTime? // When license was verified
  licenseVerificationMethod String? // 'state_bar_lookup', 'manual_upload', 'admin_review'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attorney_profiles")
}

