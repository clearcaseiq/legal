// A Letter of Protection (LOP) is the lien instrument an attorney sends a
// provider: treat the client now, get paid from the settlement later. Generated
// from a referral, optionally emailed to the provider, and linked to the
// LienHolder it creates so the lien is tracked from issuance.
model LetterOfProtection {
  id         String            @id @default(cuid())
  referralId String?
  referral   ProviderReferral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  leadId     String
  lead       LeadSubmission    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  providerId String
  provider   MedicalProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  attorneyId String
  attorney   Attorney          @relation(fields: [attorneyId], references: [id], onDelete: Cascade)

  content      String    @db.Text
  status       String    @default("draft") // draft | sent
  sentAt       DateTime?
  lienHolderId String? // the LienHolder created when this LOP was issued

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([providerId])
  @@index([referralId])
  @@map("letters_of_protection")
}

// A single treatment encounter logged against a provider referral: the visit
// itself, any diagnosis, and the amount the provider billed. This is the running
// ledger an attorney keeps to "track all treatment, diagnoses, and bills
// throughout" the lien-based treatment workflow. Access is scoped through the
// parent referral (which enforces attorney ownership); leadId/providerId are
// kept as plain columns for reporting without extra joins.
model TreatmentRecord {
  id         String           @id @default(cuid())
  referralId String
  referral   ProviderReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  leadId     String
  providerId String
  attorneyId String

  visitDate     DateTime
  visitType     String   @default("follow_up") // initial_eval, follow_up, procedure, imaging, therapy, other
  diagnosis     String? // free-text diagnosis / clinical impression
  diagnosisCode String? // optional ICD-10 code
  billedAmount  Float? // amount the provider billed for this encounter
  status        String   @default("completed") // scheduled, completed, no_show, cancelled
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralId])
  @@index([leadId])
  @@index([providerId])
  @@map("treatment_records")
}

// Evidence Upload & Management Models

model EvidenceFile {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  // File Information
  originalName String
  filename     String
  mimetype     String
  size         Int
  filePath     String
  fileUrl      String

  // Evidence Classification
  category       String // 'medical_records', 'police_report', 'bills', 'photos', 'correspondence', 'other'
  subcategory    String? // 'medical_bill', 'insurance_doc', 'accident_photo', 'damage_photo', etc.
  description    String?
  dataType       String  @default("unstructured") // 'structured', 'unstructured'
  tags           String? // JSON array of tags
  relevanceScore Float   @default(0)

  // Upload Metadata
  uploadMethod String    @default("drag_drop") // 'drag_drop', 'camera', 'file_picker'
  captureDate  DateTime? // For camera uploads
  location     String? // GPS coordinates for photos

  // EXIF Data (JSON)
  exifData String? // Camera settings, GPS, timestamp

  // Processing Status
  processingStatus String  @default("pending") // 'pending', 'processing', 'completed', 'failed'
  ocrText          String? // Extracted text from OCR
  aiSummary        String?
  aiClassification String?
  aiHighlights     String? // JSON array of highlight snippets
  visionLabels     String? // JSON: AWS Rekognition relevance verdict + detected labels

  // HIPAA Compliance
  isHIPAA          Boolean   @default(false)
  accessLevel      String    @default("private") // 'private', 'attorney', 'shared'
  retentionPolicy  String? // Retention period
  provenanceSource String?
  provenanceNotes  String?
  provenanceActor  String?
  provenanceDate   DateTime?

  // Verification
  isVerified Boolean   @default(false)
  verifiedBy String? // Attorney ID who verified
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  extractedData  ExtractedData[]
  processingJobs EvidenceProcessingJob[]
  accessLogs     EvidenceAccessLog[]
  annotations    EvidenceAnnotation[]

  // Every read of this table is "the files on this case" or "the files this user
  // owns", newest first, and neither had an index — so each evidence list was a
  // sequential scan that grew with total platform uploads.
  @@index([assessmentId, createdAt])
  @@index([userId, createdAt])
  @@map("evidence_files")
}

