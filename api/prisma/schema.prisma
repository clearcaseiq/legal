generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  role          String    @default("client") // client, attorney, staff, admin
  /// Preferred UI + communication language for plaintiffs (`en` | `es` | `zh`).
  /// Used for chat translation and localized notification chrome. Null = English.
  preferredLanguage String?
  /// JSON array of admin capability scopes (ops|network|oversight|config|users).
  /// Null/empty means full access for role=admin (backward compatible).
  /// ADMIN_EMAILS allowlist always receives every capability.
  adminCapabilities String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // OAuth fields
  googleId    String? @unique
  appleId     String? @unique
  microsoftId String? @unique
  avatar      String?
  provider    String? // 'local', 'google', 'apple', 'microsoft'

  // Consent tracking
  consents Consent[]

  assessments                Assessment[]
  favoriteAttorneys          FavoriteAttorney[]
  notifications              Notification[]
  platformNotificationEvents PlatformNotificationEvent[]
  supportTickets             SupportTicket[]
  assignedTickets            SupportTicket[]             @relation("AssignedTickets")
  appointments               Appointment[]
  reviews                    AttorneyReview[]
  chatRooms                  ChatRoom[]
  chatbotSessions            ChatBotSession[]
  evidenceFiles              EvidenceFile[]
  evidenceAnnotations        EvidenceAnnotation[]
  auditLogs                  AuditLog[]
  reviewedCaseResults        AttorneyCaseResult[] @relation("CaseResultReviewer")
  featureToggles             FeatureToggle[]
  attorneyPushDevices        AttorneyPushDevice[]
  firmMemberships            FirmMember[]
  firmTeamMemberships        FirmTeamMember[]
  caseAssignments            FirmCaseAssignment[]
  assignedCaseTasks          CaseTask[]
  intakeLeads                IntakeLead[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]

  @@map("users")
}

// Single-use, expiring tokens for the password reset / "set password" flow.
// We persist only a SHA-256 hash of the token so a DB leak can't be used to
// reset accounts. The raw token is emailed to the user and never stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Single-use, expiring tokens for the email verification flow. Like password
// reset tokens, only a SHA-256 hash is persisted; the raw token is emailed to
// the user and never stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model AttorneyPushDevice {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoPushToken String   @unique @db.VarChar(512)
  platform      String? // ios, android
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("attorney_push_devices")
}

model Consent {
  id String @id @default(cuid())

  // Nullable because intake is deliberately anonymous: a visitor authorizes
  // disclosure of their case on /results before any account exists. Keying
  // consent solely to a User meant a guest's authorization could only ever be a
  // boolean in assessment JSON — no version, hash, IP or timestamp — which is
  // the one artifact that has to be provable.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set for consents scoped to a single case rather than to the person, i.e.
  // the authorization to disclose *this* case to *these* firms.
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Consent type and version
  consentType String // 'hipaa', 'terms', 'privacy', 'marketing', 'call_recording', 'attorney_share'
  version     String // Version of the consent document
  documentId  String // Reference to the consent document

  // Consent details
  granted   Boolean // Whether consent was granted
  grantedAt DateTime? // When consent was given
  revokedAt DateTime? // When consent was revoked
  expiresAt DateTime? // When consent expires (if applicable)

  // E-signature data
  signatureData   String? // Base64 encoded signature image
  signatureMethod String? // 'drawn', 'typed', 'clicked'
  ipAddress       String? // IP address when consent was given
  userAgent       String? // Browser user agent

  // Legal compliance
  consentText String @db.Text // The actual consent text that was shown
  consentHash String // Hash of the consent text for verification

  // JSON. For 'attorney_share' this carries the attorney IDs the authorization
  // covers, so the record shows which firms the consumer named — an
  // authorization to disclose to three firms is not one to disclose to any firm.
  metadata String? @db.Text

  // Audit trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([assessmentId, consentType])
  @@map("consents")
}

model Assessment {
  id          String  @id @default(cuid())
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimType   String
  venueState  String
  venueCounty String?
  status      String  @default("DRAFT")
  facts       String  @db.Text
  // Short, human-friendly case reference (e.g. "CCIQ-7Q2K9F") shown to the
  // plaintiff after they send a case and used by phone support to identify a
  // caller (always paired with a contact fact — the code alone is not proof of
  // identity). Nullable so legacy rows load before the backfill assigns one.
  referenceCode String? @unique
  // Attorney-chosen caption, conventionally "Plaintiff v. Defendant". Free text
  // because no defendant name is captured anywhere in intake, so the caption
  // cannot be assembled from stored data. Null means fall back to the derived
  // label (plaintiff name, then claim type) — see lib/case-name.ts.
  caseName    String?

  // --- Data authority (system of record) -----------------------------------
  // Monotonic revision bumped on every material change via recordCaseChange().
  // Enables optimistic concurrency ("ours wins") and lets external systems that
  // sync FROM us order and de-duplicate changes. Never decreases.
  revision        Int     @default(0)
  // Origin of the most recent authoritative write (web | mobile | rose_ai |
  // attorney | admin | cms_inbound | reconcile | api | system). Provenance used
  // by conflict resolution and surfaced on the change feed.
  lastWriteSource String?

  // --- Case lifecycle stage (post-retention) --------------------------------
  // Null until the matter is retained; then advances monotonically through the
  // ClearCaseIQ case lifecycle (OPENING → INVESTIGATION → TREATMENT →
  // RECORD_COLLECTION → DEMAND_PREPARATION → DEMAND_SENT → NEGOTIATION →
  // SETTLEMENT_PENDING → DISBURSEMENT → CLOSED). Derived from workflow signals
  // (treatment complete, demand sent, offer received, settled) by
  // lib/case-stage.ts and never moves backwards. This is the "Case" spine — the
  // Assessment IS the case-of-record; sub-objects (insurance, liens, tasks,
  // negotiation, demand, medical) already hang off assessmentId.
  caseStage       String?
  caseStageAt     DateTime?
  // When the matter was formally closed (funds disbursed / declined / lost).
  closedAt        DateTime?

  // --- Litigation sub-track -------------------------------------------------
  // A parallel track for cases that file suit rather than resolving pre-suit.
  // Runs alongside caseStage (a case can be "in negotiation" and "in discovery"
  // at once). Null/"none" = pre-litigation. Values: none | pre_suit | filed |
  // discovery | mediation | trial | resolved. Set via lib/litigation.ts.
  litigationStatus String?
  litigationFiledAt DateTime?

  // ChatGPT Analysis
  chatgptAnalysis       String?   @db.Text // JSON string of ChatGPT analysis
  chatgptAnalysisDate   DateTime?
  similarCases          String? // JSON string of similar case outcomes
  similarCasesUpdatedAt DateTime?

  // AI incident scene schematic (generated at intake)
  sceneImageUrl    String? // relative /uploads/scenes/<file>.png
  sceneImagePrompt String?   @db.Text
  sceneImageStatus String? // null | pending | ready | failed
  sceneImageDate   DateTime?

  // Case Tier Classification
  caseTierId String?
  caseTier   CaseTier? @relation(fields: [caseTierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions   Prediction[]
  caseOutcomes  CaseOutcome[]
  files         File[]
  introductions Introduction[]
  attorneyCaseReviews AttorneyCaseReview[]
  attorneyReviews AttorneyReview[]
  demandLetters DemandLetter[]
  appointments  Appointment[]
  chatRooms     ChatRoom[]
  evidenceFiles EvidenceFile[]
  ethicalWalls  EthicalWall[]
  consents      Consent[]

  // Lead Management
  leadSubmission LeadSubmission?
  lawFirmId      String?
  lawFirm        LawFirm?        @relation(fields: [lawFirmId], references: [id], onDelete: SetNull)
  officeId       String?
  office         FirmOffice?     @relation(fields: [officeId], references: [id], onDelete: SetNull)
  teamId         String?
  team           FirmTeam?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Routing lifecycle
  routingWaves RoutingWave[]

  // Attorney workflow
  insuranceDetails    InsuranceDetail[]
  lienHolders         LienHolder[]
  settlementScenario  SettlementScenario?
  caseExpenses        CaseExpense[]
  damageItems         DamageItem[]
  liabilityRecord     LiabilityRecord?
  medicalEntries      MedicalTreatmentEntry[]
  medicalRecord       MedicalCaseRecord?
  caseTasks           CaseTask[]
  negotiationEvents   NegotiationEvent[]
  decisionMemories    DecisionMemory[]
  negotiationInsight  NegotiationInsight?
  caseNotes           CaseNote[]
  commentThreads      CaseCommentThread[]
  billingInvoices     BillingInvoice[]
  billingPayments     BillingPayment[]
  healthSnapshots     CaseHealthSnapshot[]
  caseReminders       CaseReminder[]
  recurringInvoices   RecurringInvoice[]
  caseIntakeRequests  CaseIntakeRequest[]
  caseShares          CaseShare[]
  referralAgreements  ReferralAgreement[]
  coCounselWorkflows  CoCounselWorkflow[]
  firmCaseAssignments FirmCaseAssignment[]
  caseWorkflow        CaseWorkflow?
  timeEntries         TimeEntry[]
  questionAnswers     CaseQuestionAnswer[]
  aiRuns              AiRun[]

  // Data authority: the canonical change feed and the inbound reconciliation queue.
  changeEvents           CaseChangeEvent[]
  externalWriteProposals ExternalWriteProposal[]

  // Phase 2: Communications
  platformNotificationEvents PlatformNotificationEvent[]
  supportTickets             SupportTicket[]
  caseThreads                CaseThread[]

  // Manual review queue (held for low confidence, duplicate, near-SOL, etc.)
  manualReviewStatus String? // null | pending | released | rejected | request_info | compliance
  manualReviewReason String? // low_confidence | duplicate | conflicting_facts | suspicious_documents | near_sol | unsupported_jurisdiction | premium_case | ocr_failure | fraud_suspected | identity_mismatch | document_tampering
  manualReviewHeldAt DateTime?
  manualReviewNote   String?   @db.Text
  // Fraud / suspicion review (computed by the pre-routing fraud gate).
  fraudScore         Float? // 0-100 composite suspicion score at time of hold
  fraudSignals       String?   @db.Text // JSON array of { code, label, detail, points, severity }
  reviewedBy         String? // admin/reviewer user id who made the last review decision
  reviewedAt         DateTime?

  @@index([lawFirmId])
  @@index([officeId])
  @@index([teamId])
  // "My cases, newest first" is the first query of every plaintiff session and
  // ran without an index on the owning user.
  @@index([userId, createdAt])
  @@map("assessments")
}

model InsuranceDetail {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  carrierName   String
  policyNumber  String?
  policyLimit   Float?
  adjusterName  String?
  adjusterEmail String?
  adjusterPhone String?
  notes         String?

  // Recovery path. A single case can carry both an at-fault liability claim
  // against the defendant AND a UM/UIM claim against the client's own policy,
  // so the claim type lives on each insurance record rather than the case.
  insuredParty String? // 'defendant' | 'client'
  coverageType String? // 'liability' | 'um' | 'uim' | 'medpay' | 'other'

  // Claim setup with the adjuster.
  claimNumber   String?
  claimStatus   String    @default("not_opened") // not_opened | open | accepted | denied | closed
  claimOpenedAt DateTime?

  // Dec Page (declaration page) confirms how much coverage is available — the
  // ceiling on recovery. Links to the DocumentRequest used to obtain it.
  decPageRequestId  String?
  coverageConfirmed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("insurance_details")
}

model LienHolder {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  name         String
  type         String? // medical_provider | health_insurer | medicare | medicaid | medpay | erisa | workers_comp | govt | other
  amount       Float? // asserted / billed lien amount
  finalAmount  Float? // negotiated / reduced amount actually payable (null = not yet negotiated)
  status       String     @default("open") // open | negotiating | reduced | resolved | waived
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("lien_holders")
}

// Persisted settlement waterfall inputs (one per case). Net to client =
// gross − attorney fee − case costs − (negotiated) liens.
model SettlementScenario {
  id             String     @id @default(cuid())
  assessmentId   String     @unique
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  grossAmount    Float? // attorney override of the gross recovery; null = use predicted median
  contingencyPct Float      @default(33.33)
  feeBasis       String     @default("gross") // gross | net_of_costs (fee computed after costs)
  // When true, approved billable non-attorney (staff/paralegal) time is added to
  // case costs in the waterfall. Attorney time is covered by the contingency fee.
  includeStaffTime Boolean  @default(false)
  notes          String?    @db.Text
  // Settlement lifecycle: draft → finalized (agreement reached, funds pending) →
  // disbursed (client paid, liens/costs settled). Drives the case stage engine's
  // SETTLEMENT_PENDING → DISBURSEMENT transition.
  status          String    @default("draft") // draft | finalized | disbursed
  finalizedAt     DateTime?
  finalizedByName String?
  disbursedAt     DateTime?
  disbursedByName String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("settlement_scenarios")
}

// Case costs / expenses advanced by the firm (filing fees, experts, records).
// These come off the top of a recovery before the client's net.
model CaseExpense {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  category     String     @default("other") // filing | expert | records | investigation | deposition | service | other
  description  String
  amount       Float
  incurredAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assessmentId])
  @@map("case_expenses")
}

// Structured damages ledger — the plaintiff's economic picture (as opposed to
// CaseExpense, which is the FIRM's advanced costs). Replaces the untyped
// facts.damages.{medical,lostWages,other} blob with an auditable, itemized
// ledger. Rollups are written through to facts.damages by lib/damages-ledger.ts
// so the existing valuation/demand/settlement engines pick them up unchanged.
model DamageItem {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  // Economic bucket this item rolls up into:
  //   medical | future_medical | lost_wages | lost_earning_capacity |
  //   property_damage | out_of_pocket | future_cost | other
  category     String     @default("other")
  description  String
  amount       Float      @default(0)
  // Medical-bill lifecycle (only meaningful for medical items):
  //   billed | paid | outstanding | reduced | written_off
  billingStatus String?
  provider     String? // provider / payee / employer
  incurredAt   DateTime?
  // True for projected/future amounts (future_medical, lost_earning_capacity,
  // future_cost) vs. already-incurred specials.
  isFuture     Boolean    @default(false)
  // manual | evidence (OCR) | imported
  source       String     @default("manual")
  notes        String?    @db.Text
  createdById  String?
  createdByName String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assessmentId])
  @@map("damage_items")
}

// Living liability analysis — one evolving record per case. Captures the
// fault theory, defendant/comparative fault, and the presence/status of the
// core liability evidence (police report, citation, witnesses, photos, video).
// Rollups write through to facts.liability so the underwriting engine's
// liability modifier reflects what's entered here.
model LiabilityRecord {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Narrative theory of liability ("rear-end, defendant admitted fault", etc.)
  faultTheory       String? @db.Text
  // How contested fault is: clear | disputed | admitted | denied | shared
  faultPosture      String  @default("clear")
  // Defendant's share of fault, 0-100 (the plaintiff's recovery is reduced by
  // the plaintiff's own comparative share = 100 - defendantFaultPct).
  defendantFaultPct Int     @default(100)
  // Plaintiff's own comparative negligence, 0-100.
  comparativeNegPct Int     @default(0)

  // Core liability evidence — status: none | requested | received | n/a
  policeReportStatus String  @default("none")
  policeReportNumber String?
  citationIssuedTo   String? // none | defendant | plaintiff | both
  hasWitnesses       Boolean @default(false)
  witnessCount       Int     @default(0)
  hasPhotos          Boolean @default(false)
  hasVideo           Boolean @default(false)

  // Defendant identification
  defendantName    String?
  defendantInsurer String?

  // Manual override of the derived liability strength (0-100). Null = derived.
  strengthOverride Int?

  notes         String?  @db.Text
  createdById   String?
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("liability_records")
}

// Case-level medical treatment timeline — one row per treatment episode /
// provider course of care. Keyed on the Assessment (unlike the marketplace
// ProviderReferral/TreatmentRecord which are LOP-referral scoped). Rollups
// write through to facts.treatment[] and facts.medical.* so demand-readiness,
// the treatment-gap coach, and the valuation engine reflect them.
model MedicalTreatmentEntry {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  provider   String
  specialty  String?
  // initial_eval | follow_up | procedure | surgery | imaging | therapy | er | other
  visitType  String  @default("follow_up")
  startDate  DateTime?
  endDate    DateTime?
  // ongoing | completed | discharged | referred_out | no_show
  status     String  @default("ongoing")
  diagnosis  String?
  billedAmount Float?
  // True for planned/recommended future care (feeds future-medical planning).
  isFuture   Boolean @default(false)
  notes      String? @db.Text
  source     String  @default("manual") // manual | evidence | imported
  createdById   String?
  createdByName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([assessmentId])
  @@map("medical_treatment_entries")
}

// Case-level medical status — one evolving record per case. Captures MMI,
// treatment status, symptoms, and the future-treatment plan. Write-through
// maps onto facts.medical.{mmi,mmiDate,dischargeDate,treatmentStatus,
// stillTreating,lastTreatmentDate} which the readiness/coach engines read.
model MedicalCaseRecord {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // treating | completed | mmi | discharged | unknown
  treatmentStatus String  @default("treating")
  mmi             Boolean @default(false)
  mmiDate         DateTime?
  stillTreating   Boolean @default(true)
  // JSON string array of current symptoms/complaints.
  symptoms        String? @db.Text
  // Narrative of recommended future treatment.
  futureTreatment String? @db.Text
  // Planning estimate of future medical cost (informational; enter as a
  // future_medical DamageItem to flow into the valuation).
  futureCostEstimate Float?
  notes         String?  @db.Text
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("medical_case_records")
}

model CaseTask {
  id                   String     @id @default(cuid())
  assessmentId         String
  assessment           Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title                String
  taskType             String     @default("general") // statute, milestone, checkpoint, demand_deadline, negotiation_deadline, general
  milestoneType        String? // litigation_milestone
  checkpointType       String? // medical_checkpoint
  deadlineType         String? // demand, negotiation, sol
  dueDate              DateTime?
  reminderAt           DateTime?
  escalationLevel      String     @default("none") // none, warning, critical
  assignedRole         String? // attorney, paralegal
  assignedTo           String? // name or email
  assignedUserId       String?
  assignedUser         User?      @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  status               String     @default("open") // open, done
  // AI-task human-in-the-loop review gate: null = not gated (live), 'pending' =
  // awaiting case-manager review, 'approved' = reviewed and live.
  reviewStatus         String?
  reviewedById         String?
  reviewedByName       String?
  reviewedAt           DateTime?
  priority             String     @default("medium") // low, medium, high
  notes                String?
  // JSON array of checklist items: [{ id, title, done }]
  subtasks             String?
  // Estimated effort for this task, in minutes.
  estimateMinutes      Int?
  // Denormalized creator captured on task creation.
  createdById          String?
  createdByName        String?
  sourceTemplateId     String?
  sourceTemplateStepId String?
  // Set when this task was folded into another during a merge. The row is kept
  // (closed) rather than deleted for two reasons: the AI loops dedupe on title
  // across every status, so deleting one makes the coach recreate it within the
  // sweep interval; and time entries and comment threads reference tasks by a
  // bare string with no cascade. Absorbed rows are hidden from task lists.
  mergedIntoId         String?
  completedAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([mergedIntoId])
  @@map("case_tasks")
}

model CaseWorkflowTemplate {
  id          String             @id @default(cuid())
  attorneyId  String
  attorney    Attorney           @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  name        String
  caseType    String // PI, MVA, Premises, MedMal, etc.
  description String?
  isActive    Boolean            @default(true)
  steps       CaseWorkflowStep[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("case_workflow_templates")
}

model CaseWorkflowStep {
  id                 String               @id @default(cuid())
  templateId         String
  template           CaseWorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title              String
  offsetDays         Int
  priority           String               @default("medium")
  taskType           String               @default("general")
  milestoneType      String?
  checkpointType     String?
  deadlineType       String?
  assignedRole       String?
  reminderOffsetDays Int                  @default(1)
  escalationLevel    String               @default("none")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("case_workflow_steps")
}

model NegotiationEvent {
  id                  String     @id @default(cuid())
  assessmentId        String
  assessment          Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  eventType           String // demand, offer, counter, call, note
  amount              Float?
  eventDate           DateTime   @default(now())
  status              String     @default("open") // open, pending, accepted, rejected
  notes               String?
  counterpartyType    String? // insurer, claimant
  insurerName         String?
  adjusterName        String?
  adjusterEmail       String?
  adjusterPhone       String?
  concessionValue     Float?
  concessionNotes     String?
  acceptanceRationale String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@map("negotiation_events")
}

model NegotiationInsight {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  data         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("negotiation_insights")
}

model CaseNote {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  authorId     String?
  authorName   String?
  authorEmail  String?
  noteType     String     @default("internal") // internal, plaintiff_visible, strategy, evidence, update
  message      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("case_notes")
}

// Answers captured against AI-generated "Intelligent Questions" for a case.
// Keyed by a stable questionKey (baseline questions use their bank id; AI
// questions use a hash of their text) so an answer survives question
// regeneration. The question text/section are denormalized so an answer can be
// shown even if the underlying question is no longer generated.
model CaseQuestionAnswer {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionKey    String
  questionText   String     @db.Text
  section        String? // Liability | Medical | Damages | Insurance | Case Strategy
  source         String     @default("baseline") // baseline | ai
  answer         String     @db.Text
  answeredById   String?
  answeredByName String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([assessmentId, questionKey])
  @@index([assessmentId])
  @@map("case_question_answers")
}

model CaseCommentThread {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title          String
  threadType     String     @default("general") // general, decision, task
  allowedRoles   String? // JSON array of roles allowed
  summary        String?
  // When set, this thread is the comment stream for a specific CaseTask.
  caseTaskId     String?
  createdById    String?
  createdByName  String?
  createdByEmail String?
  lastCommentAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  comments CaseComment[]

  @@index([assessmentId])
  @@index([caseTaskId])
  @@map("case_comment_threads")
}

model CaseComment {
  id          String            @id @default(cuid())
  threadId    String
  thread      CaseCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String?
  authorName  String?
  authorEmail String?
  message     String
  mentions    String? // JSON array of mention tokens/emails
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([threadId])
  @@map("case_comments")
}

model BillingInvoice {
  id                      String     @id @default(cuid())
  assessmentId            String
  assessment              Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  invoiceNumber           String?
  amount                  Float
  status                  String     @default("open") // open, paid, overdue
  dueDate                 DateTime?
  paidAt                  DateTime?
  notes                   String?
  stripeCheckoutSessionId String?    @unique
  stripePaymentIntentId   String?    @unique
  stripeCustomerId        String?
  stripePaymentStatus     String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@map("billing_invoices")
}

model BillingPayment {
  id                      String     @id @default(cuid())
  assessmentId            String
  assessment              Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  amount                  Float
  method                  String? // check, ach, card, cash
  receivedAt              DateTime   @default(now())
  reference               String?
  notes                   String?
  processor               String?
  stripeCheckoutSessionId String?    @unique
  stripePaymentIntentId   String?    @unique
  stripeChargeId          String?    @unique
  stripeCustomerId        String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@map("billing_payments")
}

model PlatformPayment {
  id                      String   @id @default(cuid())
  attorneyId              String
  attorney                Attorney @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  type                    String // subscription, lead_credit, platform_fee
  amount                  Float?
  currency                String   @default("usd")
  status                  String
  stripeCustomerId        String?
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId   String?  @unique
  stripeSubscriptionId    String?
  stripePriceId           String?
  metadata                String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([attorneyId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("platform_payments")
}

// Idempotency ledger for Stripe webhook deliveries. The event id is the primary
// key so a duplicate delivery hits a unique-constraint and is safely skipped.
model StripeWebhookEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())

  @@index([type])
  @@map("stripe_webhook_events")
}

// Litigation-funding referral submitted by a plaintiff. Tracks the requested
// amount, matched partners, and (once a partner is chosen) the selected terms
// so the plaintiff can track status and the platform can report referral volume.
model FundingRequest {
  id                  String   @id @default(cuid())
  userId              String
  assessmentId        String?
  requestedAmount     Float
  purpose             String?
  status              String   @default("pending") // pending, submitted, approved, funded, declined, cancelled
  suitablePartners    String? // JSON array of matched partners
  referralFeePct      Float?
  selectedPartnerId   String?
  selectedPartnerName String?
  approvedAmount      Float?
  interestRate        Float?
  termMonths          Int?
  monthlyPayment      Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([assessmentId])
  @@map("funding_requests")
}

model CaseHealthSnapshot {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score        Float
  level        String // green, yellow, red
  factors      String? // JSON
  createdAt    DateTime   @default(now())

  @@map("case_health_snapshots")
}

model ReminderTemplate {
  id            String         @id @default(cuid())
  attorneyId    String
  attorney      Attorney       @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  name          String
  channel       String         @default("email") // email, sms, call
  offsetDays    Int            @default(3) // days after creation
  message       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  caseReminders CaseReminder[]

  @@map("reminder_templates")
}

model CaseReminder {
  id             String            @id @default(cuid())
  assessmentId   String
  assessment     Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  templateId     String?
  template       ReminderTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel        String
  message        String
  dueAt          DateTime
  status         String            @default("scheduled") // scheduled, sent, dismissed, failed
  deliveryStatus String            @default("pending") // pending, delivered, failed
  attempts       Int               @default(0)
  sentAt         DateTime?
  lastAttemptAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("case_reminders")
}

model HealthEscalationRule {
  id         String   @id @default(cuid())
  attorneyId String
  attorney   Attorney @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  threshold  Float // score <= threshold
  action     String // recommended escalation action
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("health_escalation_rules")
}

model NegotiationCadenceTemplate {
  id               String                   @id @default(cuid())
  attorneyId       String
  attorney         Attorney                 @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  name             String
