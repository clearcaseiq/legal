model DemandLetter {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  targetAmount Float
  recipient    String
  content      String     @db.Text
  status       String     @default("DRAFT") // DRAFT | FINAL | SENT
  sentAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  title String? // caption for the letter, e.g. "Demand to State Farm"

  // How this letter came to exist. 'ai' letters are drafted by Rose and may be
  // held for review; 'pro_se' letters are generated by a claimant with no
  // account, which is why the DOCX download stays reachable without a login.
  origin String @default("attorney") // attorney | ai | pro_se
  // Whether the prose in the current content came from the LLM or the
  // deterministic template, mirroring CaseCoach.narrationSource.
  contentSource String? // ai | deterministic

  // Review gate, mirroring CaseTask. Null means no review was ever required.
  reviewStatus   String? // null | pending | approved
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?

  createdById   String?
  createdByName String?
  updatedById   String?
  updatedByName String?

  currentVersion  Int       @default(1)
  finalizedAt     DateTime?
  finalizedByName String?

  // --- Imported letters -----------------------------------------------------
  // A letter authored OUTSIDE ClearCaseIQ (Word / Google Docs) and imported so
  // the case still has one record of the demand. The original file is kept as
  // the canonical download so its formatting is preserved exactly; `content`
  // holds extracted plain text only, for the record, search, and AI context.
  // Path is relative to the API cwd and lives under a NON-public dir (not
  // /uploads) so attorney work product is served through the authenticated
  // download route rather than statically. Null on every generated letter.
  importedFilePath String?
  importedFileName String?
  importedFileMime String?

  // Set to the assessment id on a letter Rose drafted unprompted, and null on
  // every other letter. The unique constraint is the actual guard against
  // double-drafting: the coach loop runs concurrently (per evidence upload, on
  // case open, and on the sweep), so a read-then-write check cannot hold when
  // an LLM round-trip sits between the read and the insert.
  autoDraftKey String? @unique

  versions DemandLetterVersion[]

  @@index([assessmentId])
  @@map("demand_letters")
}

// A point-in-time snapshot of a demand letter's text.
//
// Every AI draft, regeneration, and human save writes one, so a letter has a
// real history: who changed the wording, when, and whether that wording came
// from Rose or a person. Previously each "edit" created a whole new letter row,
// leaving an unlabelled pile of drafts with no authorship at all.
model DemandLetterVersion {
  id             String       @id @default(cuid())
  demandLetter   DemandLetter @relation(fields: [demandLetterId], references: [id], onDelete: Cascade)
  demandLetterId String
  version        Int
  content        String       @db.Text
  source         String // ai | deterministic | human
  authorId       String?
  authorName     String?
  createdAt      DateTime     @default(now())

  @@unique([demandLetterId, version])
  @@index([demandLetterId])
  @@map("demand_letter_versions")
}

