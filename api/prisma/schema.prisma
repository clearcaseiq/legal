// ---------------------------------------------------------------------------
// CMS Integrations (Phase 0): connections to external case-management systems
// (Clio, Filevine, SmartAdvocate, CasePeer) and an audit log of every sync.
// Mirrors the AttorneyCalendarConnection pattern; tokens are stored encrypted.
// ---------------------------------------------------------------------------
model CmsConnection {
  id        String   @id @default(cuid())
  lawFirmId String
  lawFirm   LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  // Optional owning attorney (a firm may have one shared connection or per-attorney).
  attorneyId String?
  attorney   Attorney? @relation(fields: [attorneyId], references: [id], onDelete: SetNull)
  createdByUserId String?

  provider String // clio, filevine, smartadvocate, casepeer, zapier
  authType String // oauth, pat, partner, webhook

  // External identifiers returned by the provider.
  externalAccountId    String?
  externalAccountEmail String?
  externalOrgId        String?
  externalUserId       String?

  // OAuth / PAT tokens — encrypted at rest (AES-256-GCM).
  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?
  scopes         String?   @db.Text // JSON array

  // Provider-specific configuration (region base URL, webhook target, etc.).
  // Any secrets inside are individually encrypted before serialization.
  apiBaseUrl String?
  config     String? @db.Text // JSON

  status       String    @default("disconnected") // disconnected, connected, error
  lastError    String?   @db.Text
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncLogs CmsSyncLog[]

  @@unique([lawFirmId, provider, externalAccountId])
  @@index([lawFirmId])
  @@index([attorneyId])
  @@index([provider, status])
  @@map("cms_connections")
}

model CmsSyncLog {
  id           String        @id @default(cuid())
  connectionId String
  connection   CmsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  assessmentId String?

  direction    String // outbound, inbound
  operation    String // export_case, upsert_contact, create_matter, upload_document, status_update
  status       String // success, error, skipped
  externalType String? // matter, contact, document
  externalId   String?
  message      String? @db.Text
  payloadHash  String? // idempotency / change detection

  createdAt DateTime @default(now())

  @@index([connectionId])
  @@index([assessmentId])
  @@index([operation, status])
  @@map("cms_sync_logs")
}

// ---------------------------------------------------------------------------
// Data authority (system-of-record) primitives.
//
// ClearCaseIQ is the canonical source of truth for a case. Other systems sync
// FROM us: they read the canonical record + a cursor-pageable change feed, and
// when they want to write a field back they submit a *proposal* a human on the
// firm approves ("ours wins" with reconciliation). SyncApiKey authenticates
// those external readers/writers per firm.
// ---------------------------------------------------------------------------

model CaseChangeEvent {
  // `seq` is the globally-monotonic cursor external consumers page by; createdAt
  // is not unique enough to page safely. `id` stays a cuid for stable refs.
  seq          Int        @unique @default(autoincrement())
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  // Denormalized so the firm-scoped feed can page without joining assessments.
  lawFirmId    String?
  // Case revision AFTER this change was applied.
  revision     Int
  source       String // web | mobile | rose_ai | attorney | admin | cms_inbound | reconcile | api | system
  actorType    String? // user | attorney | ai | system | external
  actorId      String?
  actorLabel   String?
  action       String // status_changed | assigned | demand_generated | task_created | evidence_added | ...
  entityType   String? // assessment | task | demand | evidence | ...
  entityId     String?
  summary      String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([assessmentId, revision])
  @@index([lawFirmId, seq])
  @@index([createdAt])
  @@map("case_change_events")
}

model ExternalWriteProposal {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  lawFirmId     String?
  connectionId  String?
  provider      String?
  field         String // canonical field name (see RECONCILABLE_FIELDS)
  currentValue  String?    @db.Text
  proposedValue String?    @db.Text
  // Case revision the external system based its write on (optimistic concurrency).
  baseRevision     Int?
  source           String    @default("cms_inbound")
  status           String    @default("pending") // pending | approved | rejected | superseded
  note             String?   @db.Text
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([assessmentId])
  @@index([status])
  @@index([lawFirmId, status])
  @@map("external_write_proposals")
}

model SyncApiKey {
  id        String @id @default(cuid())
  lawFirmId String
  name      String
  // Visible, non-secret prefix for identifying the key in the UI/logs.
  prefix    String @unique
  // sha256 of the full token; the plaintext is shown once, at creation.
  tokenHash       String    @unique
  scopes          String? // JSON array; reserved for future scoping
  createdByUserId String?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([lawFirmId])
  @@map("sync_api_keys")
}
