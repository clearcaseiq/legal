/// Staging table for attorneys/firms harvested from external directories
/// (e.g. lawyers.com). Kept separate from the live `Attorney` table so scraped
/// data can be reviewed and promoted without polluting production records.
model ProductionAttorney {
  id            String  @id @default(cuid())
  source        String  @default("lawyers.com")
  // Stable dedupe key: hash of barNumber when present, else profileUrl, else
  // normalized name+location. See `buildAttorneyDedupeHash()`.
  dedupeHash    String  @db.VarChar(64)
  externalId    String?

  name          String
  firmName      String?
  email         String?
  phone         String?
  website       String? @db.VarChar(1024)
  profileUrl    String? @db.VarChar(1024)
  // Bar licence number and issuing state, digits only. Present for roster
  // sources (state bar roll); usually absent from directory scrapes.
  barNumber     String?
  barState      String?
  licenseStatus String? // Source's licence status, e.g. "Active", "Inactive"

  street        String?
  city          String?
  state         String?
  zip           String?
  county        String?
  // How `county` was determined: "county" (given by the source), "city"
  // (derived from a city lookup), or "none" (unresolved — needs follow-up
  // before this row can produce a routable attorney).
  countySource  String?
  practiceAreas String? @db.Text // JSON array of practice areas
  specialties   String? @db.Text // JSON array of board-certified specialties
  claSections   String? @db.Text // JSON array of CLA section memberships
  discipline    String? @db.Text // JSON array of disciplinary records
  lawSchool     String?
  dateOfAdmission DateTime?
  district      Int?

  // Enrichment fields (populated by website scraping)
  headshotUrl   String?  @db.VarChar(1024)
  bio           String?  @db.Text
  languages     String?  @db.Text  // JSON array of languages spoken
  caseResults   String?  @db.Text  // JSON array of notable case results/verdicts
  awards        String?  @db.Text  // JSON array of awards/recognitions
  freeConsult   Boolean? // Whether they offer free consultations
  contingencyFee String? // e.g. "33%", "33-40%"
  associations  String?  @db.Text  // JSON array of bar association memberships
  socialLinks   String?  @db.Text  // JSON object of social media URLs

  // Attorney count at the firm, where the source reports it.
  firmSize      Int?

  rating        Float?
  reviewCount   Int?

  // Pipeline state: scraped -> reviewed -> promoted | rejected
  status        String  @default("scraped")
  /// Whether this attorney likely practises PI, derived from practiceAreas/specialties.
  piRelevant    Boolean @default(false)
  // When promoted into the live `Attorney` table, the resulting attorney id.
  promotedAttorneyId String?

  sourcePage    Int?
  rawPayload    String? @db.Text // Original parsed record as JSON
  scrapedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([source, dedupeHash])
  @@index([source, status])
  @@index([state, city])
  @@index([phone])
  @@index([barNumber])
  @@index([county])
  @@map("production_attorneys")
}

/// A law-firm office location discovered through Google Places.
///
/// Places is a discovery source, not a source of record. It returns business name,
/// address, phone, website, rating and hours, but no attorney names or emails — so
/// its job is to find firms and hand us a website, from which attorneys are sourced
/// independently and then verified against the State Bar.
///
/// ## Why the columns are split into cached and retained
///
/// Google's terms do not permit building a permanent standalone database out of
/// Maps content. Place IDs are explicitly exempt and may be stored indefinitely;
/// most other Places content may only be cached temporarily. That distinction is
/// enforced here rather than left to a policy document:
///
///   - `placeId` and pipeline state are retained permanently.
///   - Everything Google returned lives in `cached*` columns with `cacheExpiresAt`,
///     and is purged on expiry by the refresh script.
///   - `websiteDomain` is retained as the minimum bridge needed to reach the firm's
///     own site, which is where the permanent record is then sourced from.
///
/// So the permanent firm and attorney records in `law_firms` / `attorneys` are
/// built from the firm's own website and the State Bar, never from this table's
/// cached columns. This table only ever answers "which firms exist and where do we
/// go to read about them".
model DiscoveredFirmLocation {
  id      String @id @default(cuid())
  /// Google's stable identifier. Exempt from Google's caching restrictions and
  /// safe to retain, which is why it is the join key for refreshing a listing
  /// rather than re-searching for it.
  placeId String @unique

  /// The search that surfaced this location, kept because being found by a
  /// personal-injury query is itself weak evidence of PI practice and is fed to
  /// segmentation as a `gbp` signal.
  discoveryQuery String?
  discoveryCity  String?

  // ===== Retained: the bridge to independent sourcing =====
  /// Registrable domain of the firm's own site. The one Google-derived value kept
  /// past cache expiry, because without it the Place ID cannot be turned back into
  /// a firm we can research.
  websiteDomain String?

  // ===== Cached Google content, purged after cacheExpiresAt =====
  cachedName            String?
  cachedFormattedAddress String?
  cachedCity            String?
  /// Google returns county as administrative_area_level_2, which is the field the
  /// routing engine needs and the hardest one to derive from a city name alone.
  cachedCounty          String?
  cachedState           String?
  cachedPostalCode      String?
  cachedPhone           String?
  cachedWebsiteUri      String? @db.VarChar(1024)
  cachedRating          Float?
  cachedReviewCount     Int?
  cachedOpeningHours    String? @db.Text
  cachedLatitude        Float?
  cachedLongitude       Float?
  cachedPrimaryType     String?
  cachedTypes           String? @db.Text
  cachedGoogleMapsUri   String? @db.VarChar(1024)
  cachedAt              DateTime?
  /// When the cached columns must be cleared or refreshed.
  cacheExpiresAt        DateTime?

  /// Pipeline state: discovered -> verified -> promoted | rejected.
  /// `verified` means we have read the firm's own website and hold an
  /// independently sourced record, which is the point at which it may be promoted.
  status String @default("discovered")
  /// Why the filter rejected it, for tuning discovery quality.
  rejectionReason String?
  /// Set when the firm's own site has been read, making the record independent of
  /// Google's cache.
  independentlySourcedAt DateTime?
  /// The live firm this became, if promoted.
  promotedLawFirmId String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([websiteDomain])
  @@index([cachedCounty])
  @@index([cacheExpiresAt])
  @@map("discovered_firm_locations")
}

/// One piece of evidence that an attorney or firm practises personal injury.
///
/// California does not certify PI as a specialty, so practice area has to be
/// inferred. Each inference input is stored as its own row rather than folded
/// straight into a score, for three reasons: scores can be recomputed when the
/// weights change without re-gathering data, a reviewer can see exactly why an
/// entity was classified, and a bad source can be retracted by deleting its rows.
///
/// Exactly one of `attorneyId` / `lawFirmId` is set. Signals attach to whichever
/// level the evidence actually describes — court filings name an attorney, a
/// website describes a firm — and firm-level evidence is inherited down to
/// attorneys at that firm at a discount when scoring.
model SegmentSignal {
  id         String   @id @default(cuid())
  attorneyId String?
  attorney   Attorney? @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  lawFirmId  String?
  lawFirm    LawFirm?  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  /// court_filing | association | bar_record | gbp | paid_search | website | directory | manual
  /// Ordered by how hard the source is to fabricate; see SIGNAL_WEIGHTS.
  source     String
  /// Specific evidence kind, e.g. "pi_complaint_filed", "caoc_member".
  kind       String
  /// plaintiff | defense | null. Null means the evidence shows PI practice but
  /// not which side of it, which is common for websites and directory listings.
  side       String?
  /// Incident type from practice-area-normalize, when the evidence is specific.
  subtype    String?
  /// How many times observed, e.g. number of PI complaints filed. Adds weight
  /// with diminishing returns.
  count      Int      @default(1)
  /// Per-signal weight override. Normally null so SIGNAL_WEIGHTS applies.
  weight     Float?
  /// Raw observed value, kept verbatim for auditing.
  value      String?  @db.Text
  /// URL, docket number or similar, so a human can verify the claim.
  sourceRef  String?  @db.VarChar(1024)
  /// When the evidence was dated. Signals decay with age, and an undated signal
  /// is treated as one half-life old rather than as fresh.
  observedAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Re-deriving a source must update rows rather than pile up duplicates.
  @@unique([attorneyId, source, kind])
  @@unique([lawFirmId, source, kind])
  @@index([attorneyId])
  @@index([lawFirmId])
  @@index([source, kind])
  @@map("segment_signals")
}

/// Derived PI classification for one attorney or firm: the output of scoring all
/// of that entity's SegmentSignal rows.
///
/// Entirely derived and safe to rebuild from signals at any time. `scoreVersion`
/// records which algorithm produced the row so a weight change can be rolled out
/// by recomputing only stale versions.
model AttorneySegment {
  id         String    @id @default(cuid())
  attorneyId String?   @unique
  attorney   Attorney? @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  lawFirmId  String?   @unique
  lawFirm    LawFirm?  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)

  /// 0-1 confidence that this entity practises personal injury at all.
  piScore         Float   @default(0)
  /// plaintiff | defense | both | unknown. The routing-critical field: defense
  /// firms score high on PI and must never receive claimant leads.
  piSide          String  @default("unknown")
  /// 0-1 confidence in `piSide` specifically, which is not the same as piScore.
  sideConfidence  Float   @default(0)
  /// JSON array of incident types, most-supported first.
  piSubtypes      String? @db.Text
  /// none | low | medium | high. High requires corroboration from at least two
  /// sources that are not the firm describing itself.
  confidence      String  @default("none")
  /// Whether this entity may receive claimant (plaintiff-side) PI leads, with
  /// the reason. Denormalized from the score so routing need not re-derive it.
  claimantEligible Boolean @default(false)
  eligibilityReason String? @db.Text
  /// Human-readable explanation of the score, one line per factor (JSON array).
  rationale       String? @db.Text
  /// Scoring diagnostics as JSON: weights per side, source counts, newest evidence.
  breakdown       String? @db.Text
  signalCount     Int     @default(0)
  /// Set when the score came from the firm rather than this attorney's own evidence.
  inheritedFromFirm Boolean @default(false)

  scoreVersion String
  scoredAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([piSide, piScore])
  @@index([claimantEligible])
  @@index([scoreVersion])
  @@map("attorney_segments")
}

/// Yelp-style "claim your profile" flow. Each row is one claim attempt against
/// an unclaimed (scraped/imported) Attorney record, with a single-use token and
/// an OTP/bar-number verification step before an account is linked.
model ProfileClaim {
  id              String    @id @default(cuid())
  attorneyId      String
  attorney        Attorney  @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  // Single-use token embedded in the claim/invite link.
  token           String    @unique
  // Channel the invite / verification code was sent to.
  email           String?
  phone           String?
  // email_code | sms_code | bar_number | manual
  method          String?
  // Hashed one-time passcode (bcrypt). Never store the raw code.
  codeHash        String?
  codeExpiresAt   DateTime?
  attempts        Int       @default(0)
  // sent | verified | completed | expired | rejected
  status          String    @default("sent")
  claimedByUserId String?
  verifiedAt      DateTime?
  completedAt     DateTime?
  expiresAt       DateTime
  meta            String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([attorneyId, status])
  @@index([status])
  @@map("profile_claims")
}

model CaseTier {
  id          String @id @default(cuid())
  tierNumber  Int    @unique // 1, 2, 3, 4
  name        String @unique // "Tier 1", "Tier 2", etc.
  color       String // "green", "yellow", "blue", "red"
  label       String // "Low Severity / High Volume", etc.
  description String // Full description

  // Settlement Range
  minSettlementRange Float? // Minimum typical settlement
  maxSettlementRange Float? // Maximum typical settlement

  // Buying Model
  buyingModel String // "Fixed price", "Fixed price + subscription", etc.

  // Lawyer Profile
  lawyerProfile String // "High-volume PI shops", etc.

  // Goal
  goal String // "Liquidity, scale, predictable flow", etc.

  // Case Types (JSON array)
  caseTypes String // JSON array of case types

  // Characteristics (JSON array)
  characteristics String // JSON array of characteristics

  // Promotion Rules (JSON) - Conditions that can promote cases to higher tiers
  promotionRules String? // JSON object with promotion conditions

  // Metadata
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assessments Assessment[]

  @@map("case_tiers")
}

/// A settlement or verdict an attorney reports on their own profile.
///
/// These are self-reported until an admin reviews the supporting document and
/// marks them verified, so `status` is never writable by the attorney — only by
/// the admin review endpoints. Editing a verified result sends it back to
/// pending, otherwise an attorney could get a modest result approved and then
/// change the number.
model AttorneyCaseResult {
  id         String   @id @default(cuid())
  attorneyId String
  attorney   Attorney @relation(fields: [attorneyId], references: [id], onDelete: Cascade)

  caseType         String
  /// 'settlement' | 'verdict'
  resultType       String  @default("settlement")
  settlementAmount Float   @default(0)
  caseDescription  String?
  /// Kept as the entered YYYY-MM-DD string: these are historical dates with no
  /// time component, and parsing them to DateTime shifted them across zones.
  date             String?
  venue            String?
  caseNumber       String?

  /// Supporting document, stored privately under uploads/verdict-documents.
  documentUrl  String?
  documentName String?

  /// 'pending' | 'verified' | 'rejected'
  status       String    @default("pending")
  reviewedById String?
  reviewedBy   User?     @relation("CaseResultReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  /// Why it was rejected. Shown to the attorney so a rejection is actionable.
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attorneyId])
  // The review queue reads pending rows oldest-first across all attorneys.
  @@index([status, createdAt])
  @@map("attorney_case_results")
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
