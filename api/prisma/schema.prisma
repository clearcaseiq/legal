  isActive         Boolean                  @default(true)
  steps            NegotiationCadenceStep[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@map("negotiation_cadence_templates")
}

model NegotiationCadenceStep {
  id         String                     @id @default(cuid())
  templateId String
  template   NegotiationCadenceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  offsetDays Int
  channel    String // email, sms, call
  message    String
  sortOrder  Int                        @default(0)

  @@map("negotiation_cadence_steps")
}

model TaskSlaTemplate {
  id            String        @id @default(cuid())
  attorneyId    String
  attorney      Attorney      @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  name          String
  triggerStatus String // contacted, consulted, retained
  isActive      Boolean       @default(true)
  steps         TaskSlaStep[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("task_sla_templates")
}

model TaskSlaStep {
  id         String          @id @default(cuid())
  templateId String
  template   TaskSlaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  offsetDays Int
  priority   String          @default("medium")

  @@map("task_sla_steps")
}

model RecurringInvoice {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  amount       Float
  intervalDays Int        @default(30)
  nextRunAt    DateTime
  lastRunAt    DateTime?
  status       String     @default("active") // active, paused
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("recurring_invoices")
}

model Prediction {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  modelVersion String
  viability    String
  bands        String
  explain      String
  createdAt    DateTime   @default(now())

  @@map("predictions")
}

/// Historical resolution of a case, used to backtest and calibrate the valuation engine
/// against real-world settlement/verdict outcomes (see lib/valuation-calibration.ts).
model CaseOutcome {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  outcomeType  String     // settlement | verdict | dismissed | withdrawn
  grossAmount  Float? // total resolution amount (gross, pre-fee)
  netToClient  Float?
  resolvedAt   DateTime?
  // Snapshot of the prediction + features at the time of resolution, so calibration can
  // replay the exact inputs that produced the prediction being evaluated.
  predictedMedian  Float?
  featuresSnapshot String? @db.Text // JSON feature vector (computeFeatures output)
  source       String     @default("manual") // manual | attorney_reported | docket_import
  notes        String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assessmentId])
  @@index([outcomeType])
  @@index([resolvedAt])
  @@map("case_outcomes")
}

model Attorney {
  id                String   @id @default(cuid())
  name              String
  email             String?  @unique
  phone             String?
  // State bar licence number, digits only. Issued once per person and never
  // reused, so this is the dedup key for bulk imports — email and phone both
  // collide across attorneys who share a firm.
  barNumber         String?  @unique
  barState          String? // Two-letter state that issued barNumber, e.g. "CA"
  specialties       String
  venues            String
  meta              String?  @db.Text
  profile           String?  @db.Text // Enhanced profile data (JSON)
  isActive          Boolean  @default(true)
  // Hard routing gate: an unverified attorney is never eligible for a lead.
  // This is a vetting decision, not a data-quality flag — bulk importers must
  // leave it false and let a human or a bar-status lookup flip it.
  isVerified        Boolean  @default(false)
  // Yelp-style profile claiming: unclaimed | pending | claimed
  claimStatus       String   @default("unclaimed")
  claimedByUserId   String?
  claimedAt         DateTime?
  responseTimeHours Int      @default(24)
  averageRating     Float    @default(0.0)
  totalReviews      Int      @default(0)
  // Public "Calendly-style" booking: shareable slug + the timezone the attorney's
  // weekly availability windows are expressed in.
  bookingSlug       String?  @unique
  schedulingTimezone String? // IANA tz, e.g. "America/Los_Angeles"
  lawFirmId         String?
  lawFirm           LawFirm? @relation(fields: [lawFirmId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  introductions               Introduction[]
  attorneyCaseReviews         AttorneyCaseReview[]
  favoriteAttorneys           FavoriteAttorney[]
  appointments                Appointment[]
  reviews                     AttorneyReview[]
  availability                AttorneyAvailability[]
  chatRooms                   ChatRoom[]
  ethicalWalls                EthicalWall[]
  caseSharesBy                CaseShare[]            @relation("CaseShareSharedByAttorney")
  caseSharesWith              CaseShare[]            @relation("CaseShareSharedWithAttorney")
  referralAgreementsReferring ReferralAgreement[]    @relation("ReferralAgreementReferringAttorney")
  referralAgreementsReceiving ReferralAgreement[]    @relation("ReferralAgreementReceivingAttorney")
  coCounselWorkflowsLead      CoCounselWorkflow[]    @relation("CoCounselWorkflowLeadAttorney")
  coCounselWorkflowsCoCounsel CoCounselWorkflow[]    @relation("CoCounselWorkflowCoCounselAttorney")

  // Attorney Dashboard Relations
  dashboard                   AttorneyDashboard?
  attorneyProfile             AttorneyProfile?             @relation("AttorneyProfile")
  leadSubmissions             LeadSubmission[]
  leadContacts                LeadContact[]
  caseContacts                CaseContact[]
  documentRequests            DocumentRequest[]
  documentEnvelopes           DocumentEnvelope[]
  leadAnalytics               LeadAnalytics[]
  conflictChecks              ConflictCheck[]
  providerReferrals           ProviderReferral[]
  lettersOfProtection         LetterOfProtection[]
  reminderTemplates           ReminderTemplate[]
  healthRules                 HealthEscalationRule[]
  negotiationCadenceTemplates NegotiationCadenceTemplate[]
  taskSlaTemplates            TaskSlaTemplate[]
  caseIntakeRequests          CaseIntakeRequest[]
  intakeConfig                AttorneyIntakeConfig?
  workflowTemplates           CaseWorkflowTemplate[]
  decisionMemories            DecisionMemory[]
  decisionProfile             AttorneyDecisionProfile?
  auditLogs                   AuditLog[]
  caseResults                 AttorneyCaseResult[]
  smsWebhookReceipts          SmsWebhookReceipt[]
  reputationScore             AttorneyReputationScore?
  importSources               AttorneyImportSource[]
  profileClaims               ProfileClaim[]
  calendarConnections         AttorneyCalendarConnection[]
  zoomConnection              AttorneyZoomConnection?
  calendarBusyBlocks          AttorneyCalendarBusyBlock[]
  eventTypes                  AttorneyEventType[]
  firmBookingLinkMemberships  FirmBookingLinkMember[]
  platformPayments            PlatformPayment[]
  firmMemberships             FirmMember[]
  firmCaseAssignments         FirmCaseAssignment[]
  cmsConnections              CmsConnection[]

  // Phase 2: Communications
  platformNotificationEvents PlatformNotificationEvent[]
  supportTickets             SupportTicket[]

  // Personal-injury segmentation
  segmentSignals             SegmentSignal[]
  segment                    AttorneySegment?

  @@index([phone])
  @@map("attorneys")
}

model LawFirm {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  primaryEmail String?
  phone        String?
  website      String?
  // Registrable domain from `website` (or a firm email), e.g. "smithlaw.com".
  // Firms have no public registry identifier and their names vary by source
  // (DBAs, punctuation, entity suffixes), so this is the practical dedup key.
  firmDomain   String? @unique
  // Normalized `name` with entity suffixes and boilerplate stripped, for
  // dedup when no domain is known. Not unique: distinct firms in different
  // cities legitimately share a normalized name, so match on nameKey + state.
  nameKey      String?
  address      String?
  city         String?
  state        String?
  zip          String?

  // Public marketplace profile
  tagline       String?
  description   String? @db.Text
  logoUrl       String?
  practiceAreas String? @db.Text // JSON array
  foundedYear   Int?
  isPublic      Boolean @default(true)

  // Per-firm overrides of the default role→permission map (firm-roles.ts).
  // JSON object: { [role]: string[] }. Absent roles fall back to defaults.
  rolePermissions String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decisionMemories DecisionMemory[]
  decisionProfiles AttorneyDecisionProfile[]

  // Relations
  attorneys       Attorney[]
  settings        FirmSetting[]
  featureToggles  FeatureToggle[]
  offices         FirmOffice[]
  teams           FirmTeam[]
  members         FirmMember[]
  cases           Assessment[]
  caseAssignments FirmCaseAssignment[]
  cmsConnections  CmsConnection[]
  bookingLinks    FirmBookingLink[]
  templates       FirmTemplate[]
  workflows       FirmWorkflow[]
  billingRates    BillingRate[]
  timeEntries     TimeEntry[]

  // Personal-injury segmentation
  segmentSignals  SegmentSignal[]
  segment         AttorneySegment?

  @@index([nameKey, state])
  @@map("law_firms")
}

model FirmOffice {
  id             String   @id @default(cuid())
  lawFirmId      String
  lawFirm        LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  name           String
  city           String?
  state          String?
  address        String?
  phone          String?
  countiesServed String?  @db.Text // JSON array
  languages      String?  @db.Text // JSON array
  practiceAreas  String?  @db.Text // JSON array
  capacity       Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members FirmMember[]
  teams   FirmTeam[]
  cases   Assessment[]

  @@index([lawFirmId])
  @@map("firm_offices")
}

model FirmMember {
  id          String      @id @default(cuid())
  lawFirmId   String
  lawFirm     LawFirm     @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attorneyId  String?
  attorney    Attorney?   @relation(fields: [attorneyId], references: [id], onDelete: SetNull)
  officeId    String?
  office      FirmOffice? @relation(fields: [officeId], references: [id], onDelete: SetNull)
  role        String      @default("intake_specialist") // firm_admin, attorney, case_manager, intake_specialist, paralegal, billing_admin, legal_assistant, demand_writer, medical_records
  title       String?
  permissions String?     @db.Text // JSON array of explicit overrides
  status      String      @default("active") // invited, active, suspended
  invitedAt   DateTime?
  joinedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  teamMemberships FirmTeamMember[]

  @@unique([lawFirmId, userId])
  @@index([lawFirmId, role])
  @@index([attorneyId])
  @@index([officeId])
  @@map("firm_members")
}

// Lightweight direct message between two members of the same firm (not tied to a
// case). Threaded by the (sender, recipient) User pair; scalar user ids keep this
// decoupled from the User model (no back-relations required).
model FirmDirectMessage {
  id          String    @id @default(cuid())
  lawFirmId   String // LawFirm.id (scalar; no relation to avoid User/LawFirm back-refs)
  senderId    String // User.id of the sender
  recipientId String // User.id of the recipient
  body        String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([lawFirmId])
  @@index([recipientId, readAt])
  @@index([senderId, recipientId])
  @@map("firm_direct_messages")
}

model FirmTeam {
  id          String      @id @default(cuid())
  lawFirmId   String
  lawFirm     LawFirm     @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  officeId    String?
  office      FirmOffice? @relation(fields: [officeId], references: [id], onDelete: SetNull)
  name        String
  teamType    String      @default("case_team") // intake, litigation, demand, records, billing, case_team
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members FirmTeamMember[]
  cases   Assessment[]

  @@index([lawFirmId])
  @@index([officeId])
  @@map("firm_teams")
}

model FirmTeamMember {
  id           String     @id @default(cuid())
  teamId       String
  team         FirmTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  firmMemberId String
  firmMember   FirmMember @relation(fields: [firmMemberId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String     @default("member") // lead, member
  createdAt    DateTime   @default(now())

  @@unique([teamId, firmMemberId])
  @@index([userId])
  @@map("firm_team_members")
}

model FirmCaseAssignment {
  id                 String     @id @default(cuid())
  lawFirmId          String
  lawFirm            LawFirm    @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  assessmentId       String
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assignedUserId     String?
  assignedUser       User?      @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedAttorneyId String?
  assignedAttorney   Attorney?  @relation(fields: [assignedAttorneyId], references: [id], onDelete: SetNull)
  role               String // lead_attorney, secondary_attorney, case_manager, paralegal, intake_owner, billing_owner, demand_writer, medical_records
  status             String     @default("active") // active, reassigned, completed, removed
  assignedById       String?
  notes              String?
  dueDate            DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([assessmentId, role, assignedUserId, assignedAttorneyId])
  @@index([lawFirmId])
  @@index([assessmentId])
  @@index([assignedUserId])
  @@index([assignedAttorneyId])
  @@map("firm_case_assignments")
}

model FirmSetting {
  id        String   @id @default(cuid())
  lawFirmId String
  lawFirm   LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  key       String
  value     String // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lawFirmId, key])
  @@index([lawFirmId])
  @@map("firm_settings")
}

model FeatureToggle {
  id          String   @id @default(cuid())
  key         String
  description String?
  enabled     Boolean  @default(false)
  scope       String   @default("global") // global, firm, user
  lawFirmId   String?
  lawFirm     LawFirm? @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, scope, lawFirmId, userId])
  @@index([key])
  @@index([lawFirmId])
  @@index([userId])
  @@map("feature_toggles")
}

model AttorneyDecisionProfile {
  id               String   @id @default(cuid())
  attorneyId       String   @unique
  attorney         Attorney @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  lawFirmId        String?
  lawFirm          LawFirm? @relation(fields: [lawFirmId], references: [id], onDelete: SetNull)
  negotiationStyle String?
  riskTolerance    String?
  preferences      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([lawFirmId])
  @@map("attorney_decision_profiles")
}

model File {
  id            String      @id @default(cuid())
  assessment    Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId  String?
  originalName  String
  filename      String
  mimetype      String
  size          Int
  path          String
  status        String      @default("UPLOADED")
  extractedText String?
  summary       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("files")
}

model Introduction {
  id                 String     @id @default(cuid())
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId       String
  attorney           Attorney   @relation(fields: [attorneyId], references: [id])
  attorneyId         String
  status             String     @default("PENDING") // PENDING, ACCEPTED, DECLINED, REQUESTED_INFO
  message            String     @default("")
  requestedAt        DateTime   @default(now())
  respondedAt        DateTime?
  declineReason      String? // Reason when status=DECLINED
  requestedInfoNotes String?    @db.Text // Notes when status=REQUESTED_INFO
  waveNumber         Int        @default(1) // Which routing wave this was part of
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([attorneyId, status, requestedAt])
  @@index([assessmentId])
  @@map("introductions")
}

model SmsWebhookReceipt {
  id               String    @id @default(cuid())
  provider         String    @default("twilio")
  messageSid       String?   @unique
  requestId        String?
  fromPhone        String?
  normalizedFrom   String?
  messageBody      String?   @db.Text
  decision         String?
  attorneyId       String?
  responseCode     Int?
  responseMessage  String?   @db.Text
  processingStatus String    @default("received") // received, processed, ignored, duplicate, failed
  introductionId   String?
  leadSubmissionId String?
  errorMessage     String?   @db.Text
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  attorney Attorney? @relation(fields: [attorneyId], references: [id], onDelete: SetNull)

  @@index([attorneyId])
  @@index([processingStatus, createdAt])
