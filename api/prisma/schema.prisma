model AttorneyReview {
  id         String   @id @default(cuid())
  attorneyId String
  attorney   Attorney @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The case the review is about.
  ///
  /// A plaintiff who works with the same attorney on two matters holds a separate
  /// opinion of each, so a review is identified by (attorney, plaintiff, case).
  /// The constraint used to be the (attorney, plaintiff) pair, which meant a
  /// second review silently overwrote the first and the attorney's rating showed
  /// only the most recent case (CP-480).
  ///
  /// Nullable only to carry rows written before this column existed. Every write
  /// path now supplies it, and the API rejects a review with no case, so nulls
  /// are historical rather than something new code can produce. Note that
  /// Postgres treats nulls as distinct in a unique index, so the constraint below
  /// does not bound those legacy rows — it does not need to, since there is at
  /// most one of them per pair by construction.
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  rating     Int // 1-5 stars
  title      String?
  review     String?
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attorneyId, userId, assessmentId])
  @@map("attorney_reviews")
}

