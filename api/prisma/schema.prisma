/// Which API instance is currently responsible for running the background
/// sweeps. Exactly one holds this at a time.
///
/// The sweeps send email and SMS to claimants and attorneys, escalate routing
/// offers and generate AI tasks. They were started unconditionally on boot,
/// which is correct on one instance and actively harmful on two: a second
/// instance does not share the work, it duplicates it. Nothing would have
/// errored — both instances would report healthy while every claimant received
/// two SOL warnings and every offer escalated twice.
///
/// A lease rather than a config flag naming one instance, because the flag
/// stops the work entirely when that instance dies, which gives up half the
/// reason for running two. Here the lease simply expires and the survivor takes
/// over.
///
/// All timestamps are written and compared using the database clock, never the
/// application's. Two instances disagreeing about the time by a few seconds is
/// ordinary; if that skew decided lease expiry, both could believe they hold it.
model SchedulerLease {
  /// Fixed key, so the table holds one row per class of scheduled work.
  name      String   @id
  /// hostname:pid of the holder. Diagnostic — the lease is correct without it,
  /// but "which box is actually running the sweeps" is otherwise unanswerable.
  holder    String
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scheduler_leases")
}

/// Geocoded centre point of a 5-digit US ZIP, cached so provider radius search
/// does not pay for a geocode on every request. A row with null coordinates
/// records a ZIP the geocoder could not resolve, which stops an unresolvable
/// ZIP from re-hitting the paid API on each search.
/// Per-IP request counters for the limiters that protect credential and
/// spend-bearing endpoints.
///
/// Shared rather than in-process because the limit is meant to be a property of
/// the platform, not of one server. With counters in memory and two instances
/// behind a load balancer, a caller alternating between them gets the
/// configured allowance twice over — so sign-in, sized at 30 attempts per
/// quarter hour to make password guessing impractical, quietly allowed 60.
model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  /// Supports the opportunistic sweep of counters whose window has passed.
  @@index([expiresAt])
  @@map("rate_limit_counters")
}

/// Last-known outcome of each background sweep, so the admin status page can
/// answer "are the scheduled jobs healthy" from any instance.
///
/// The counters used to live only in the process that ran them, which was fine
/// with one host. With two, the sweeps run on whichever holds the scheduler
/// lease, and the status request lands on whichever the load balancer picks —
/// so half the time the page found an empty list and, having nothing failing
/// or overdue to report, called it healthy. An operator reading it would
/// reasonably conclude the jobs had stopped.
model SweepRun {
  name           String    @id
  label          String
  enabled        Boolean   @default(true)
  intervalMs     Int?
  /// Which instance last ran it; matches the scheduler lease holder.
  holder         String?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastDurationMs Int?
  /// Null until it has finished at least once.
  ok             Boolean?
  lastError      String?   @db.Text
  runs           Int       @default(0)
  failures       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sweep_runs")
}

